<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>9</LangVersion>
        <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
        <RootNamespace>DeusaldLocalizerCommon</RootNamespace>
        <AssemblyName>DeusaldLocalizerCommon</AssemblyName>
    </PropertyGroup>

    <!-- NuGet package metadata -->
    <PropertyGroup>
        <PackageId>DeusaldLocalizerCommon</PackageId>
        <Version>1.7.8</Version>
        <Authors>Deusald</Authors>
        <Company>Deusald</Company>
        <Description>Shared domain models, persistence, and business/sync logic for Deusald Localizer, a community localization tool for games. Consumable by external readers such as a Unity importer.</Description>
        <PackageTags>localization;localizer;i18n;translation;games;unity;deusald</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2026 Deusald</Copyright>
        <PackageProjectUrl>https://github.com/Deusald/DeusaldLocalizer</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Deusald/DeusaldLocalizer</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
      <PackageReference Include="ClosedXML" Version="0.105.0" />
      <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="SmartFormat" Version="3.6.1" />
    </ItemGroup>

    <ItemGroup>
      <None Include="../README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
