@page "/"
@layout MainLayout
@inject ProjectStateService  _ProjectState
@inject IProjectStoreFactory _StoreFactory
@inject IndexedDbInterop     _Idb
@inject WebProjectArchive    _Archive
@inject IAuthTokenStore      _AuthTokens
@inject NavigationManager    _Nav
@inherits LocalizedComponentBase

<PageTitle>Deusald Localizer</PageTitle>

<div class="home-root">

    @* ── Left panel ───────────────────────────────────────────────────── *@
    <div class="home-left">
        <div>
            <div class="home-logo">
                <div class="home-logo-orbs">
                    <div class="home-orb home-orb-1"></div>
                    <div class="home-orb home-orb-2"></div>
                    <div class="home-orb home-orb-3"></div>
                </div>
                <div>
                    <div class="home-logo-text-name">Deusald Localizer</div>
                    <div class="home-logo-text-sub">@Loc.T(Localization.Home.Web.tagline)</div>
                </div>
            </div>

            <h1 class="home-headline">@Loc.T(Localization.Home.subtitle)</h1>
            <p class="home-sub">@Loc.T(Localization.Home.Web.intro)</p>
        </div>

        <div>
            @if (_ErrorMessage is not null)
            {
                <div class="dl-alert dl-alert-error home-error">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>@_ErrorMessage</span>
                </div>
            }

            <div class="home-actions">
                <button class="home-btn home-btn-primary" @onclick="OpenNewProjectModal" disabled="@_IsBusy">
                    <span class="home-btn-icon">+</span>
                    <span>@Loc.T(Localization.Home.newProject)</span>
                </button>

                <button class="home-btn home-btn-secondary" @onclick="ImportZip" disabled="@_IsBusy">
                    @if (_IsBusy)
                    {
                        <span class="dl-spinner" style="width:14px;height:14px;flex-shrink:0;"></span>
                        <span>@Loc.T(Localization.Home.Web.working)</span>
                    }
                    else
                    {
                        <span class="home-btn-icon"><i class="bi bi-file-earmark-zip"></i></span>
                        <span>@Loc.T(Localization.Home.Web.importZip)</span>
                    }
                </button>

                <button class="home-btn home-btn-secondary" @onclick="OpenConnectModal" disabled="@_IsBusy">
                    <span class="home-btn-dot"></span>
                    <span>@Loc.T(Localization.Home.connectServer)</span>
                </button>
            </div>

            <div class="home-version">
                <span>v@(BuildInfo.Version)</span>
                @if (!string.IsNullOrEmpty(BuildInfo.CommitHash))
                {
                    <span class="home-version-sep">·</span>
                    <span class="home-version-hash">@BuildInfo.CommitHash</span>
                }
                <span class="home-version-sep">·</span>
                <LanguagePicker/>
            </div>
        </div>
    </div>

    @* ── Right panel ──────────────────────────────────────────────────── *@
    <div class="home-right">
        <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:20px;">
            <div class="home-recents-label" style="margin-bottom:0;">@Loc.T(Localization.Home.Web.yourProjects)</div>
        </div>

        @if (_Projects.Count == 0)
        {
            <div class="home-empty">
                <div class="home-empty-title">@Loc.T(Localization.Home.Web.emptyTitle)</div>
                <div class="home-empty-sub">@Loc.T(Localization.Home.Web.emptySub)</div>
            </div>
        }
        else
        {
            <div class="home-recent-list">
                @{ string[] swatches = ["#5b6cff", "#3ad98a", "#ff6b6b", "#f5a623", "#a78bfa"]; }
                @for (int x = 0; x < _Projects.Count; ++x)
                {
                    ProjectSummary p       = _Projects[x];
                    string         initial = p.Name.Length > 0 ? p.Name[0].ToString().ToUpper() : "P";
                    string         swatch  = swatches[x % swatches.Length];
                    string meta = p.KeyCount > 0
                                      ? Loc.T(Localization.Home.projectMeta, new Dictionary<string, object>
                                        {
                                            ["keys"]   = p.KeyCount,
                                            ["langs"]  = p.LangCount,
                                            ["edited"] = LastEditedLabel(p.UpdatedAt),
                                        })
                                      : LastEditedLabel(p.UpdatedAt);

                    <div class="home-recent-item-wrap">
                        <button class="home-recent-item" @onclick="() => OpenProject(p.Location)" disabled="@_IsBusy" title="@p.Name">
                            <div class="home-recent-swatch" style="background: @swatch">@initial</div>
                            <div class="home-recent-meta">
                                <div class="home-recent-top">
                                    <span class="home-recent-name">@p.Name</span>
                                    @if (p.IsOnline)
                                    {
                                        <span class="home-recent-tag-remote">@Loc.T(Localization.Home.remoteTag)</span>
                                    }
                                </div>
                                <div class="home-recent-sub">@meta</div>
                            </div>
                            @if (p.KeyCount > 0)
                            {
                                <div class="home-recent-progress">
                                    <div class="home-recent-progress-top">
                                        <span>@Loc.T(Localization.Home.langCount, new Dictionary<string, object> { ["count"] = p.LangCount })</span>
                                        <span class="home-recent-progress-pct">@p.TranslationPct%</span>
                                    </div>
                                    <div class="home-recent-progress-bar">
                                        <div class="home-recent-progress-fill" style="width: @p.TranslationPct%"></div>
                                    </div>
                                </div>
                            }
                            <i class="bi bi-chevron-right home-recent-arrow"></i>
                        </button>
                        <button class="home-recent-remove home-recent-export"
                                @onclick="() => ExportProject(p)"
                                disabled="@_IsBusy"
                                title="@Loc.T(Localization.Home.Web.downloadTooltip)">
                            <i class="bi bi-download"></i>
                        </button>
                        <button class="home-recent-remove home-recent-delete"
                                @onclick="() => AskDelete(p)"
                                disabled="@_IsBusy"
                                title="@Loc.T(Localization.Home.Web.deleteTooltip)">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    <NewProjectModal OnConfirm="OnNewProjectConfirmed" @ref="_NewProjectModal"/>

    <ConnectServerModal @ref="_ConnectModal"
                        AutoLocation="true"
                        OnConfirm="OnConnectConfirmed"
                        OnCancel="OnConnectCancelled"/>

    <AccessTokenModal @ref="_AccessTokenModal" OnClose="OnAccessTokenAcknowledged"/>

    @* ── Delete confirmation ──────────────────────────────────────────── *@
    @if (_PendingDelete is not null)
    {
        <div class="home-confirm-backdrop" @onclick="CancelDelete"></div>
        <div class="home-confirm-box" @onclick:stopPropagation="true">
            <div class="home-confirm-header">
                <span class="home-confirm-title">@Loc.T(Localization.Home.Web.deleteTitle)</span>
            </div>
            <div class="home-confirm-body">
                @Loc.T(Localization.Home.Web.deleteBody, new Dictionary<string, object> { ["name"] = _PendingDelete.Name })
            </div>
            <div class="home-confirm-warn">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@Loc.T(Localization.Home.Web.deleteWarn)</span>
            </div>
            <div class="home-confirm-footer">
                <button class="home-confirm-btn home-confirm-btn-ghost" @onclick="CancelDelete" disabled="@_IsBusy">@Loc.T(Localization.Common.Buttons.cancel)</button>
                <button class="home-confirm-btn home-confirm-btn-danger" @onclick="ConfirmDelete" disabled="@_IsBusy">@Loc.T(Localization.Home.Web.deleteConfirm)</button>
            </div>
        </div>
    }

</div>

@code {
    private bool                 _IsBusy;
    private string?              _ErrorMessage;
    private List<ProjectSummary> _Projects = new();
    private NewProjectModal?     _NewProjectModal;
    private ConnectServerModal?  _ConnectModal;
    private AccessTokenModal?    _AccessTokenModal;
    private ProjectSummary?      _PendingDelete;

    // Carries the connected project across the token-modal step, when a first sign-in must rotate its token.
    private LocProject? _PendingProject;
    private string?     _PendingLocation;
    private Guid        _PendingUserId;

    private sealed record ProjectSummary(
        string Location,
        string Name,
        int KeyCount,
        int LangCount,
        int TranslationPct,
        DateTime UpdatedAt,
        bool IsOnline);

    protected override async Task OnInitializedAsync()
    {
        // Ask the browser to keep our storage durable so offline projects and pending edits aren't evicted.
        await _Idb.PersistAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _ErrorMessage = null;
        List<ProjectSummary> found = new();

        try
        {
            // Only the Localizer's own projects — the IndexedDB store is shared with the Story web app on this origin.
            foreach (string location in await _Idb.ListLocationsAsync(WebProjectLocationService.LocationPrefix))
            {
                IProjectFileStore store = _StoreFactory.Create(location);

                // Fully open each project so the card can show the same stats as the desktop app
                // (translation %, last-edited). Skip anything that isn't a valid project folder.
                LocProject project;
                try
                {
                    project = await ProjectFileService.OpenAsync(store);
                }
                catch
                {
                    continue;
                }

                int pct = 0;
                if (project is { Metadata.Languages.Count: > 1, Keys.Count: > 0 })
                {
                    int totalSlots = project.Keys.Count * project.Metadata.Languages.Count;
                    int translated = project.TotalNumberOfApprovedKeys();
                    // Floor so 100% shows only when every slot is translated, not when rounding up from 99.5%.
                    pct = totalSlots > 0 ? (int)Math.Floor(translated * 100.0 / totalSlots) : 0;
                }

                found.Add(new ProjectSummary(
                    location,
                    project.Metadata.Name,
                    project.Keys.Count,
                    project.Metadata.Languages.Count,
                    pct,
                    project.Metadata.UpdatedAt,
                    project.Metadata.IsOnline));
            }

            _Projects = found.OrderByDescending(p => p.UpdatedAt).ToList();
        }
        catch (Exception ex)
        {
            _ErrorMessage = Loc.T(Localization.Home.Web.errReadProjects, new Dictionary<string, object> { ["msg"] = ex.Message });
        }
    }

    /// <summary>Mirrors <c>RecentProjectEntry.LastEditedLabel</c> so web cards read like the desktop ones.</summary>
    private string LastEditedLabel(DateTime lastEdited)
    {
        TimeSpan diff = DateTime.Now - lastEdited;
        if (diff.TotalMinutes < 2) return Loc.T(Localization.Home.timeJustNow);
        if (diff.TotalHours < 1) return Loc.T(Localization.Home.timeMinutes, new Dictionary<string, object> { ["m"] = (int)diff.TotalMinutes });
        if (diff.TotalDays < 1) return Loc.T(Localization.Home.timeHours, new Dictionary<string, object> { ["h"] = (int)diff.TotalHours });
        if (diff.TotalDays < 7) return Loc.T(Localization.Home.timeDays, new Dictionary<string, object> { ["d"] = (int)diff.TotalDays });
        return lastEdited.ToString("MMM d");
    }

    private async Task OpenProject(string location)
    {
        _IsBusy       = true;
        _ErrorMessage = null;
        StateHasChanged();

        try
        {
            IProjectFileStore store   = _StoreFactory.Create(location);
            LocProject        project = await ProjectFileService.OpenAsync(store);

            // Replay pending (unpushed) changes so the editor reflects in-flight local edits.
            foreach (LocEntryChange change in project.UncommitedChanges)
                EntryChangeExeService.ExecuteChange(project, change, out _);

            // Offline projects use the offline member. Online onboarding (login) is handled separately.
            _ProjectState.LoadProject(project, location, LocProjectMember.OfflineMember.UserId, Guid.Empty);
            _Nav.NavigateTo("translate");
        }
        catch (Exception ex)
        {
            _ErrorMessage = Loc.T(Localization.Home.Web.errOpen, new Dictionary<string, object> { ["msg"] = ex.Message });
            _IsBusy       = false;
        }
    }

    private void OpenNewProjectModal() => _NewProjectModal?.Show();

    private void OnNewProjectConfirmed(NewProjectModal.NewProjectArgs args)
    {
        _ProjectState.CreateNewProject(args.Name, args.Slug, args.Description, args.MainLanguageCode);
        _Nav.NavigateTo("translate");
    }

    // ── Connect to server ─────────────────────────────────────────────────

    private void OpenConnectModal() => _ConnectModal?.Show();

    private void OnConnectCancelled()
    {
        /* modal hides itself */
    }

    /// <summary>
    /// Downloads a whole online project from the bot into a freshly minted IndexedDB namespace, then loads
    /// it exactly like opening a local online project. A member still carrying the admin's one-time token
    /// (first sign-in) rotates it to their own and is shown the new token once; a returning member — setting
    /// up on another browser — keeps their existing token and loads straight in. Mirrors the desktop flow,
    /// except the download target is the opaque location the web location service minted (no folder nesting).
    /// </summary>
    private async Task OnConnectConfirmed(ConnectServerModal.ConnectArgs args)
    {
        ConnectResult result = await _ProjectState.ConnectToServerAsync(
                                   args.ApiUrl, args.ProjectId, args.Username, args.Token, _ => args.ParentLocation);

        if (result.Error != null || result.Project is null || result.Location is null || result.Member is null)
        {
            _ConnectModal?.ShowError(result.Error ?? Loc.T(Localization.Home.errConnect));
            return;
        }

        LocProjectMember member = result.Member;

        // First connect: the member still carries the admin-issued one-time token. Rotate it to a fresh
        // random token straight away (authenticated with the token the user just entered — the only one
        // the server knows), then show it once for them to store.
        if (member.MustResetAccessToken)
        {
            InitialTokenResult rotation = await _ProjectState.RotateInitialTokenAsync(
                                              result.Project, result.Location, member, args.Token);

            if (rotation.RawToken == null)
            {
                _ConnectModal?.ShowError(rotation.Error ?? Loc.T(Localization.Home.errSignIn));
                return;
            }

            _PendingProject  = rotation.Project!;
            _PendingLocation = result.Location;
            _PendingUserId   = member.UserId;
            _ConnectModal?.Hide();
            StateHasChanged();

            _AccessTokenModal?.Show(rotation.RawToken, Loc.T(Localization.Common.AccessToken.newTokenTitle), Loc.T(Localization.Common.AccessToken.newTokenBody));
            return; // FinalizeLoad runs once the user closes the token modal
        }

        // Returning member — cache the raw token for next time and load straight in.
        await _AuthTokens.SaveAsync(result.Project.Metadata.Id, result.Location, member.UserId, args.Token);
        _ConnectModal?.Hide();
        FinalizeLoad(result.Project, result.Location, member.UserId, Guid.NewGuid());
    }

    private void OnAccessTokenAcknowledged()
    {
        if (_PendingProject is null || _PendingLocation is null) return;
        FinalizeLoad(_PendingProject, _PendingLocation, _PendingUserId, Guid.NewGuid());
    }

    /// <summary>Loads the connected online project into the session and opens the editor.</summary>
    private void FinalizeLoad(LocProject project, string location, Guid userId, Guid sessionToken)
    {
        _ProjectState.LoadProject(project, location, userId, sessionToken);
        _Nav.NavigateTo("translate");
    }

    private async Task ImportZip()
    {
        _IsBusy       = true;
        _ErrorMessage = null;
        StateHasChanged();

        try
        {
            string? location = await _Archive.ImportAsync();
            if (location is null)
            {
                _IsBusy = false;
                return; // user cancelled the file picker
            }

            await OpenProject(location);
        }
        catch (Exception ex)
        {
            _ErrorMessage = Loc.T(Localization.Home.Web.errImport, new Dictionary<string, object> { ["msg"] = ex.Message });
            _IsBusy       = false;
        }
    }

    private async Task ExportProject(ProjectSummary p)
    {
        try
        {
            string slug = string.IsNullOrWhiteSpace(p.Name) ? "project" : p.Name.Replace(' ', '-');
            await _Archive.ExportAsync(p.Location, $"{slug}.zip");
        }
        catch (Exception ex)
        {
            _ErrorMessage = Loc.T(Localization.Home.Web.errExport, new Dictionary<string, object> { ["msg"] = ex.Message });
        }
    }

    // ── Delete (with confirmation — removal from the browser is permanent) ──

    private void AskDelete(ProjectSummary p) => _PendingDelete = p;

    private void CancelDelete() => _PendingDelete = null;

    private async Task ConfirmDelete()
    {
        if (_PendingDelete is null) return;

        _IsBusy = true;
        StateHasChanged();

        try
        {
            await _Idb.DeleteLocationAsync(_PendingDelete.Location);
            _PendingDelete = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _ErrorMessage = Loc.T(Localization.Home.Web.errDelete, new Dictionary<string, object> { ["msg"] = ex.Message });
        }
        finally
        {
            _IsBusy = false;
        }
    }

}
