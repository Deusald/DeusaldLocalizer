@namespace DeusaldLocalizerWeb.Components.Common
@inject IProjectLocationService _LocationPicker
@inject UiLocalizationService Loc

@if (_Visible)
{
    <div class="csm-backdrop" @onclick="Cancel"></div>

    <div class="csm-box" @onclick:stopPropagation="true">

        <div class="csm-header">
            <div>
                <div class="csm-title">@Loc.T(Localization.Common.ConnectServer.title)</div>
                <div class="csm-subtitle">@Loc.T(Localization.Common.ConnectServer.subtitle)</div>
            </div>
            <button class="csm-close" @onclick="Cancel" title="@Loc.T(Localization.Common.Buttons.close)" disabled="@_Busy">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="csm-body">

            @* ── Server URL ────────────────────────────────────────────── *@
            <div class="csm-field">
                <label class="csm-label">@Loc.T(Localization.Common.ConnectServer.serverUrlLabel)</label>
                <input class="csm-input csm-input-mono" type="text"
                       placeholder="https://bot.example.com"
                       @bind="_ApiUrl" @bind:event="oninput" disabled="@_Busy"/>
            </div>

            @* ── Project ID ────────────────────────────────────────────── *@
            <div class="csm-field">
                <label class="csm-label">
                    @Loc.T(Localization.Common.ConnectServer.projectIdLabel)
                    <span class="csm-label-hint">@Loc.T(Localization.Common.ConnectServer.projectIdHint)</span>
                </label>
                <input class="csm-input csm-input-mono" type="text"
                       placeholder="00000000-0000-0000-0000-000000000000"
                       @bind="_ProjectId" @bind:event="oninput" disabled="@_Busy"/>
                @if (!string.IsNullOrEmpty(_ProjectId) && !Guid.TryParse(_ProjectId, out _))
                {
                    <div class="csm-field-error">@Loc.T(Localization.Common.ConnectServer.invalidProjectId)</div>
                }
            </div>

            @* ── Username ──────────────────────────────────────────────── *@
            <div class="csm-field">
                <label class="csm-label">@Loc.T(Localization.Common.ConnectServer.usernameLabel)</label>
                <input class="csm-input" type="text" placeholder="jane.doe"
                       @bind="_Username" @bind:event="oninput" disabled="@_Busy"/>
            </div>

            @* ── Access token ──────────────────────────────────────────── *@
            <div class="csm-field">
                <label class="csm-label">@Loc.T(Localization.Common.ConnectServer.accessTokenLabel)</label>
                <input class="csm-input" type="password" placeholder="@Loc.T(Localization.Common.ConnectServer.tokenPlaceholder)"
                       @bind="_Token" @bind:event="oninput" disabled="@_Busy"/>
            </div>

            @* ── Storage location ──────────────────────────────────────── *@
            @* On the web a project lives in its own IndexedDB namespace, minted automatically on connect,
               so there is nothing for the user to pick — the folder picker is desktop-only. *@
            @if (!AutoLocation)
            {
                <div class="csm-field">
                    <label class="csm-label">
                        @Loc.T(Localization.Common.ConnectServer.storeInLabel)
                        <span class="csm-label-hint">@Loc.T(Localization.Common.ConnectServer.storeInHint)</span>
                    </label>
                    <div class="csm-location">
                        <span class="csm-location-path @(string.IsNullOrEmpty(_Location) ? "csm-location-empty" : "")">
                            @(string.IsNullOrEmpty(_Location) ? Loc.T(Localization.Common.ConnectServer.noFolderSelected) : _Location)
                        </span>
                        <button class="csm-btn csm-btn-ghost csm-btn-sm" @onclick="Browse" disabled="@_Busy">
                            <i class="bi bi-folder2-open"></i> @Loc.T(Localization.Common.ConnectServer.browseButton)
                        </button>
                    </div>
                </div>
            }

            @if (_Error != null)
            {
                <div class="csm-error">
                    <i class="bi bi-exclamation-triangle"></i> @_Error
                </div>
            }

        </div>

        <div class="csm-footer">
            <button class="csm-btn csm-btn-ghost" @onclick="Cancel" disabled="@_Busy">@Loc.T(Localization.Common.Buttons.cancel)</button>
            <button class="csm-btn csm-btn-primary" @onclick="Confirm" disabled="@(!_CanConfirm || _Busy)">
                @if (_Busy)
                {
                    <span class="dl-spinner" style="width:14px;height:14px;flex-shrink:0;"></span>
                    <span>@Loc.T(Localization.Common.ConnectServer.connecting)</span>
                }
                else
                {
                    <span>@Loc.T(Localization.Common.ConnectServer.connectButton)</span>
                }
            </button>
        </div>

    </div>
}

@code {
    [Parameter] public EventCallback<ConnectArgs> OnConfirm { get; set; }
    [Parameter] public EventCallback              OnCancel  { get; set; }

    /// <summary>
    /// When true the storage-location picker is hidden and the location is minted automatically on
    /// connect. Used by the web client, where a project is simply a fresh IndexedDB namespace with no
    /// folder for the user to choose; desktop leaves this false and shows the native folder picker.
    /// </summary>
    [Parameter]
    public bool AutoLocation { get; set; }

    // ── State ──────────────────────────────────────────────────────────────

    private bool    _Visible;
    private bool    _Busy;
    private string  _ApiUrl    = "";
    private string  _ProjectId = "";
    private string  _Username  = "";
    private string  _Token     = "";
    private string  _Location  = "";
    private string? _Error;

    // ── Public API ─────────────────────────────────────────────────────────

    public void Show()
    {
        _ApiUrl    = "";
        _ProjectId = "";
        _Username  = "";
        _Token     = "";
        _Location  = "";
        _Error     = null;
        _Busy      = false;
        _Visible   = true;
        StateHasChanged();
    }

    /// <summary>Surfaces a connect failure inline and re-enables the form for another attempt.</summary>
    public void ShowError(string error)
    {
        _Error = error;
        _Busy  = false;
        StateHasChanged();
    }

    // ── Validation ─────────────────────────────────────────────────────────

    private bool _CanConfirm =>
        !string.IsNullOrWhiteSpace(_ApiUrl) &&
        Guid.TryParse(_ProjectId, out _) &&
        !string.IsNullOrWhiteSpace(_Username) &&
        !string.IsNullOrWhiteSpace(_Token) &&
        (AutoLocation || !string.IsNullOrEmpty(_Location));

    // ── Handlers ───────────────────────────────────────────────────────────

    private async Task Browse()
    {
        string? picked                               = await _LocationPicker.PickSaveLocationAsync(string.Empty);
        if (!string.IsNullOrEmpty(picked)) _Location = picked;
    }

    private async Task Confirm()
    {
        if (!_CanConfirm || _Busy) return;
        _Error = null;
        _Busy  = true;
        StateHasChanged();

        // Web: no folder was picked, so mint the IndexedDB namespace to download into now.
        string location = _Location;
        if (AutoLocation && string.IsNullOrEmpty(location))
            location = await _LocationPicker.PickSaveLocationAsync(string.Empty) ?? string.Empty;

        await OnConfirm.InvokeAsync(new ConnectArgs(
            _ApiUrl.Trim(), Guid.Parse(_ProjectId), _Username.Trim(), _Token.Trim(), location));
    }

    private async Task Cancel()
    {
        if (_Busy) return;
        _Visible = false;
        await OnCancel.InvokeAsync();
    }

    /// <summary>Hides the modal (parent calls this once the connect succeeds).</summary>
    public void Hide()
    {
        _Visible = false;
        StateHasChanged();
    }

    /// <summary>Result passed back to the parent when the user confirms.</summary>
    public record ConnectArgs(
        string ApiUrl,
        Guid ProjectId,
        string Username,
        string Token,
        string ParentLocation);

}
