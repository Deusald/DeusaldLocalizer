@namespace DeusaldLocalizerWeb.Components.Common
@inject IJSRuntime _Js

@if (_Visible)
{
    <div class="atm-backdrop" @onclick="Close"></div>

    <div class="atm-box" @onclick:stopPropagation="true">
        <div class="atm-header">
            <div>
                <div class="atm-title">@_Title</div>
                <div class="atm-subtitle">@_Subtitle</div>
            </div>
            <button class="atm-close" @onclick="Close"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="atm-body">
            <div class="atm-token">
                <code class="atm-token-text">@_Token</code>
                <button class="atm-copy @(_Copied ? "copied" : "")" @onclick="Copy" title="Copy">
                    <i class="bi @(_Copied ? "bi-check-lg" : "bi-clipboard")"></i>
                </button>
            </div>

            <div class="atm-warning">
                <i class="bi bi-exclamation-triangle"></i>
                <span>Store this token somewhere safe — for security it won't be shown again.</span>
            </div>
        </div>

        <div class="atm-footer">
            <button class="atm-btn atm-btn-primary" @onclick="Close">Done</button>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private bool   _Visible;
    private bool   _Copied;
    private string _Token    = "";
    private string _Title    = "Access token";
    private string _Subtitle = "";

    public void Show(string token, string title, string subtitle)
    {
        _Token    = token;
        _Title    = title;
        _Subtitle = subtitle;
        _Copied   = false;
        _Visible  = true;
        StateHasChanged();
    }

    private async Task Copy()
    {
        try
        {
            await _Js.InvokeVoidAsync("copyToClipboard", _Token);
            _Copied = true;
        }
        catch
        {
            // Clipboard unavailable — the token is still visible for manual copy.
        }
    }

    private async Task Close()
    {
        _Visible = false;
        StateHasChanged();
        await OnClose.InvokeAsync();
    }
}
