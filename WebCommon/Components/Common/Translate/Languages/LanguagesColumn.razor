@namespace DeusaldLocalizerWeb.Components.Common
@inject ProjectStateService _ProjectState
@inject UiLocalizationService Loc
@implements IDisposable

<div class="lc-root">

    @if (!_AddMode)
    {
        <div class="lc-search-wrap">
            <i class="bi bi-search lc-search-icon"></i>
            <input class="lc-search" type="text" placeholder="@Loc.T(Localization.Translate.Languages.searchLanguages)"
                   @bind="_Filter" @bind:event="oninput"/>
        </div>

        <div class="lc-list">
            @foreach (string code in _FilteredLanguages)
            {
                LanguageDisplay disp   = CultureService.DescribeLanguage(code);
                bool            active = code == SelectedLanguage;
                bool            isMain = code == _ProjectState.CurrentProject!.Metadata.MainLanguageId;
                int             pct    = ProgressFor(code);

                @if (_EditMode)
                {
                    <div class="lc-item lc-item-editing">
                        <div class="lc-item-top">
                            <span class="lc-item-flag">@disp.Flag</span>
                            <span class="lc-item-name">@disp.Name</span>
                            @if (disp.IsVariant)
                            {
                                <span class="lc-item-var-badge">@Loc.T(Localization.Translate.Languages.subBadge)</span>
                            }
                            @if (isMain)
                            {
                                <span class="lc-item-main-badge">@Loc.T(Localization.Translate.Languages.srcBadge)</span>
                            }
                            <button class="lc-item-subadd" title="@Loc.T(Localization.Translate.Languages.addSubLanguage)" @onclick="() => BeginAddVariant(code)">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                            @if (!isMain)
                            {
                                <button class="lc-item-remove" title="@Loc.T(Localization.Translate.Languages.removeLanguage)" @onclick="() => RemoveLanguage(code)">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>
                        @if (_VariantParent == code)
                        {
                            <div class="lc-variant-add">
                                <span class="lc-variant-prefix">@(code)_</span>
                                <input class="lc-variant-input" placeholder="@Loc.T(Localization.Translate.Languages.variantTagPlaceholder)" autofocus
                                       @bind="_VariantTag" @bind:event="oninput"
                                       @onkeydown="e => OnVariantKeyDown(e, code)"/>
                                <button class="lc-variant-confirm" title="@Loc.T(Localization.Translate.Languages.addSubLanguage)" @onclick="() => ConfirmAddVariant(code)">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button class="lc-variant-cancel" title="@Loc.T(Localization.Common.Buttons.cancel)" @onclick="CancelAddVariant">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <button class="lc-item @(active ? "active" : "")" @onclick="() => OnLanguageSelected.InvokeAsync(code)">
                        <div class="lc-item-top">
                            <span class="lc-item-flag">@disp.Flag</span>
                            <span class="lc-item-name">@disp.Name</span>
                            @if (isMain)
                            {
                                <span class="lc-item-main-badge">SRC</span>
                            }
                            <span class="lc-item-pct">@pct%</span>
                        </div>
                        <div class="lc-item-bar">
                            <div class="lc-item-fill" style="width:@pct%"></div>
                        </div>
                    </button>
                }
            }
        </div>

        @if (_IsAdmin)
        {
            @if (_EditMode)
            {
                <button class="lc-cancel-btn" @onclick="() => _EditMode = false">@Loc.T(Localization.Translate.Languages.done)</button>
            }
            else
            {
                <div class="lc-bottom-actions">
                    <button class="lc-add-btn" @onclick="EnterAddMode">
                        <i class="bi bi-plus-lg"></i> @Loc.T(Localization.Translate.Languages.addLanguage)
                    </button>
                    <button class="lc-edit-btn" @onclick="() => _EditMode = true" title="@Loc.T(Localization.Translate.Languages.editLanguages)">
                        <i class="bi bi-pencil"></i>
                    </button>
                </div>
            }
        }
    }
    else
    {
        <div class="lc-add-header">
            <span class="lc-add-title">@Loc.T(Localization.Translate.Languages.addLanguage)</span>
        </div>

        <div class="lc-search-wrap">
            <i class="bi bi-search lc-search-icon"></i>
            <input class="lc-search" type="text" placeholder="@Loc.T(Localization.Translate.Languages.searchByNameOrCode)"
                   @bind="_AddQuery" @bind:event="oninput"/>
        </div>

        <div class="lc-add-results">
            @{ HashSet<string> existing = new HashSet<string>(_ProjectState.CurrentProject!.Metadata.Languages); }
            @{ List<CultureEntry> hits = CultureService.Search(_AddQuery).Where(c => !existing.Contains(c.Code)).ToList(); }
            @if (hits.Count == 0)
            {
                <div class="lc-add-empty">@Loc.T(Localization.Translate.Languages.noResults)</div>
            }
            else
            {
                @foreach (CultureEntry c in hits.Take(100))
                {
                    CultureEntry entry = c;
                    <button class="lc-add-item" @onclick="() => AddLanguage(entry.Code)">
                        <span class="lc-add-flag">@entry.FlagEmoji</span>
                        <span class="lc-add-name">@entry.EnglishName</span>
                        <span class="lc-add-code">@entry.Code</span>
                        <i class="bi bi-plus lc-add-plus"></i>
                    </button>
                }
            }
        </div>

        <button class="lc-cancel-btn" @onclick="ExitAddMode">@Loc.T(Localization.Common.Buttons.cancel)</button>
    }

</div>

@code {
    [Parameter] public string                SelectedLanguage   { get; set; } = "";
    [Parameter] public EventCallback<string> OnLanguageSelected { get; set; }

    private string  _Filter = "";
    private bool    _AddMode;
    private bool    _EditMode;
    private string  _AddQuery = "";
    private string? _VariantParent;              // language a sub-language is being added to (edit mode)
    private string  _VariantTag = "";

    private bool _IsAdmin => _ProjectState.CurrentUser.IsAdmin;

    protected override void OnInitialized()
    {
        _ProjectState.ProjectDataChanged += OnProjectDataChanged;
    }

    private IEnumerable<string> _FilteredLanguages
    {
        get
        {
            IEnumerable<string> langs = _ProjectState.CurrentProject!.Metadata.Languages.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_Filter))
            {
                string q = _Filter.Trim().ToLowerInvariant();
                langs = langs.Where(code =>
                    code.ToLowerInvariant().Contains(q)
                    || CultureService.DescribeLanguage(code).Name.ToLowerInvariant().Contains(q));
            }
            return langs;
        }
    }

    private int ProgressFor(string code)
    {
        LocProject project  = _ProjectState.CurrentProject!;
        int        keyCount = project.Keys.Count;
        if (keyCount == 0) return 0;
        int translated = project.GetNumberOfApprovedKeys(code);
        return (int)Math.Round(translated * 100.0 / keyCount);
    }

    private void EnterAddMode()
    {
        _AddQuery = "";
        _AddMode  = true;
    }

    private void ExitAddMode()
    {
        _AddMode = false;
    }

    private void AddLanguage(string code)
    {
        LocProject project = _ProjectState.CurrentProject!;
        if (project.Metadata.Languages.Contains(code)) return;
        project.Metadata.Languages.Add(code);
        _ProjectState.RecordLanguageAdded(code);
        ExitAddMode();
    }

    // ── Sub-language (variant) add ────────────────────────────────────────────

    private void BeginAddVariant(string parentCode)
    {
        _VariantParent = parentCode;
        _VariantTag    = "";
    }

    private void CancelAddVariant()
    {
        _VariantParent = null;
        _VariantTag    = "";
    }

    private void OnVariantKeyDown(KeyboardEventArgs e, string parentCode)
    {
        if (e.Key == "Enter")       ConfirmAddVariant(parentCode);
        else if (e.Key == "Escape") CancelAddVariant();
    }

    private void ConfirmAddVariant(string parentCode)
    {
        string tag = SanitizeTag(_VariantTag);
        if (tag.Length == 0) return;
        // Sub-languages are stored as "{parent}_{tag}"; see CultureService.SplitVariant.
        AddLanguage($"{parentCode}_{tag}");
        CancelAddVariant();
    }

    /// <summary>Trims the tag and collapses internal whitespace to hyphens so the code stays clean.</summary>
    private static string SanitizeTag(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        System.Text.StringBuilder sb = new();
        bool pendingDash = false;
        foreach (char c in raw.Trim())
        {
            if (char.IsWhiteSpace(c))
            {
                if (sb.Length > 0) pendingDash = true;
            }
            else
            {
                if (pendingDash) { sb.Append('-'); pendingDash = false; }
                sb.Append(c);
            }
        }
        return sb.ToString();
    }

    private async Task RemoveLanguage(string code)
    {
        LocProject project = _ProjectState.CurrentProject!;
        if (code == project.Metadata.MainLanguageId) return; // main language can't be removed
        project.Metadata.Languages.Remove(code);
        _ProjectState.RecordLanguageRemoved(code);
        if (SelectedLanguage != code) return;
        string fallback = project.Metadata.Languages.Find(l => l != project.Metadata.MainLanguageId)
                          ?? project.Metadata.MainLanguageId;
        await OnLanguageSelected.InvokeAsync(fallback);
    }

    private void OnProjectDataChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _ProjectState.ProjectDataChanged -= OnProjectDataChanged;
    }

}