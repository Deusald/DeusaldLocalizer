@namespace DeusaldLocalizerWeb.Components.Common
@inject ProjectStateService _ProjectState
@inject UiLocalizationService Loc

@if (_Conflict is not null)
{
    <div class="crb-root">

        <div class="crb-header">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span class="crb-title">@_HeaderTitle</span>
        </div>

        <p class="crb-desc">@_Description</p>

        <div class="crb-compare">
            <div class="crb-panel crb-panel-server">
                <span class="crb-panel-label">@_LeftLabel</span>
                <div class="crb-panel-text @(string.IsNullOrEmpty(_LeftText) ? "crb-panel-empty" : "")">
                    @(string.IsNullOrEmpty(_LeftText) ? Loc.T(Localization.Translate.KeyDetail.ConflictResolution.empty) : _LeftText)
                </div>
            </div>
            <div class="crb-panel crb-panel-mine">
                <span class="crb-panel-label">@_RightLabel</span>
                <div class="crb-panel-text @(string.IsNullOrEmpty(_RightText) ? "crb-panel-empty" : "")">
                    @(string.IsNullOrEmpty(_RightText) ? Loc.T(Localization.Translate.KeyDetail.ConflictResolution.empty) : _RightText)
                </div>
            </div>
        </div>

        <div class="crb-actions">
            <button class="crb-btn crb-btn-primary" @onclick="() => Resolve(ConflictResolution.KeepMine)" disabled="@_Busy">
                @Loc.T(Localization.Translate.KeyDetail.ConflictResolution.keepMine)
            </button>
            <button class="crb-btn crb-btn-accent" @onclick="() => Resolve(ConflictResolution.SuggestMine)" disabled="@_Busy">
                @Loc.T(Localization.Translate.KeyDetail.ConflictResolution.suggestMine)
            </button>
            <button class="crb-btn crb-btn-ghost" @onclick="() => Resolve(ConflictResolution.KeepServer)" disabled="@_Busy">
                @Loc.T(Localization.Translate.KeyDetail.ConflictResolution.keepServer)
            </button>
        </div>

        <ul class="crb-hints">
            <li><strong>@Loc.T(Localization.Translate.KeyDetail.ConflictResolution.keepMine)</strong> @Loc.T(Localization.Translate.KeyDetail.ConflictResolution.keepMineHint)</li>
            <li><strong>@Loc.T(Localization.Translate.KeyDetail.ConflictResolution.suggestMine)</strong> @Loc.T(Localization.Translate.KeyDetail.ConflictResolution.suggestMineHint)</li>
            <li><strong>@Loc.T(Localization.Translate.KeyDetail.ConflictResolution.keepServer)</strong> @Loc.T(Localization.Translate.KeyDetail.ConflictResolution.keepServerHint)</li>
        </ul>

    </div>
}

@code {
    [Parameter] public LocLocalizationKey Key              { get; set; } = null!;
    [Parameter] public string             SelectedLanguage { get; set; } = "";
    [Parameter] public EventCallback      OnChanged        { get; set; }

    private bool _Busy;

    private EntryChangeConflict? _Conflict => _ProjectState.ConflictFor(Key.Id, SelectedLanguage);

    private string _MineText   => _ProjectState.PendingTranslationText(Key.Id, SelectedLanguage) ?? "";
    private string _ServerText => Key.Translations.Find(t => t.LanguageId == SelectedLanguage)?.Text ?? "";
    private string _SourceText => Key.Translations.Find(t => t.LanguageId == _ProjectState.CurrentProject!.Metadata.MainLanguageId)?.Text ?? "";

    private bool _IsSourceConflict => _Conflict?.Type == EntryConflictType.SourceChanged;

    private string _HeaderTitle => _Conflict?.Type switch
    {
        EntryConflictType.SourceChanged => Loc.T(Localization.Translate.KeyDetail.ConflictResolution.sourceChangedTitle),
        EntryConflictType.DestChanged   => Loc.T(Localization.Translate.KeyDetail.ConflictResolution.destChangedTitle),
        _                               => Loc.T(Localization.Translate.KeyDetail.ConflictResolution.conflictTitle),
    };

    private string _Description => _Conflict?.Type switch
    {
        EntryConflictType.SourceChanged => Loc.T(Localization.Translate.KeyDetail.ConflictResolution.sourceChangedDesc),
        EntryConflictType.DestChanged   => Loc.T(Localization.Translate.KeyDetail.ConflictResolution.destChangedDesc),
        _                               => "",
    };

    private string _LeftLabel => _IsSourceConflict ? Loc.T(Localization.Translate.KeyDetail.ConflictResolution.currentSourceLabel) : Loc.T(Localization.Translate.KeyDetail.ConflictResolution.onServerNowLabel);
    private string _LeftText  => _IsSourceConflict ? _SourceText : _ServerText;

    private string _RightLabel => _IsSourceConflict ? Loc.T(Localization.Translate.KeyDetail.ConflictResolution.yourTranslationLabel) : Loc.T(Localization.Translate.KeyDetail.ConflictResolution.yourEditLabel);
    private string _RightText  => _MineText;

    private async Task Resolve(ConflictResolution resolution)
    {
        _Busy = true;
        await _ProjectState.ResolveConflictAsync(Key.Id, SelectedLanguage, resolution);
        _Busy = false;
        await OnChanged.InvokeAsync();
    }
}
