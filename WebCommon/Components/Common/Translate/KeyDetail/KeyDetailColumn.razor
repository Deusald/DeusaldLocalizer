@namespace DeusaldLocalizerWeb.Components.Common
@inject ProjectStateService _ProjectState
@inject UiLocalizationService Loc
@implements IDisposable

<div class="kd-root">

    @if (SelectedKeyId == null || _SelectedKey == null)
    {
        <div class="kd-empty">
            <i class="bi bi-key kd-empty-icon"></i>
            <span>@Loc.T(Localization.Translate.KeyDetail.emptyState)</span>
        </div>
    }
    else
    {
        <div class="kd-scroll">

            @* ── Header ───────────────────────────────────────────────────── *@
            <div class="kd-header">
                <div class="kd-header-top">
                    <div class="kd-header-title-row">
                        <span class="kd-key-name">@FullKeyName(_SelectedKey)</span>
                        <span class="kd-status-tag @_StatusTagClass">@LocalizedStatus(_StatusTagLabel)</span>
                    </div>
                    <div class="kd-header-right">
                        <div class="kd-header-dates">
                            <span title="@Loc.T(Localization.Translate.KeyDetail.titleCreated)">@Loc.T(Localization.Translate.KeyDetail.createdOn, new Dictionary<string, object> { ["date"] = _SelectedKey.CreatedAt.ToString("MMM d, yyyy") })</span>
                            <span class="kd-dates-sep">·</span>
                            <span title="@Loc.T(Localization.Translate.KeyDetail.titleLastUpdated)">@Loc.T(Localization.Translate.KeyDetail.updatedOn, new Dictionary<string, object> { ["date"] = _SelectedKey.UpdatedAt.ToString("MMM d, yyyy") })</span>
                        </div>
                        @if (_IsAdmin)
                        {
                            @if (_ConfirmDeleteKey)
                            {
                                <span class="kd-delete-confirm">
                                    <span>@Loc.T(Localization.Translate.KeyDetail.deleteKeyConfirm)</span>
                                    <button class="kd-confirm-yes" @onclick="DeleteKey">@Loc.T(Localization.Common.Buttons.delete)</button>
                                    <button class="kd-confirm-no" @onclick="() => _ConfirmDeleteKey = false">@Loc.T(Localization.Common.Buttons.cancel)</button>
                                </span>
                            }
                            else
                            {
                                <button class="kd-delete-btn" title="@Loc.T(Localization.Translate.KeyDetail.titleDeleteKey)" @onclick="() => _ConfirmDeleteKey = true">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        }
                    </div>
                </div>

                <KeyFlagsBar Key="@_SelectedKey" OnChanged="StateHasChanged"/>
            </div>

            @* ── Description ─────────────────────────────────────────────── *@
            <KeyDescriptionBlock Key="@_SelectedKey" OnChanged="StateHasChanged"/>

            @* ── Tags ─────────────────────────────────────────────────────── *@
            <KeyTagsBar Key="@_SelectedKey" OnChanged="StateHasChanged"/>

            @* ── Sync conflict ───────────────────────────────────────────── *@
            <ConflictResolutionBox Key="@_SelectedKey" SelectedLanguage="@SelectedLanguage"
                                   OnChanged="StateHasChanged"/>

            @* ── Translation editor ──────────────────────────────────────── *@
            <TranslationEditor Key="@_SelectedKey" SelectedLanguage="@SelectedLanguage"
                               OnChanged="StateHasChanged"
                               OnDraftChanged="OnDraftChanged"/>

            @* ── Preview ──────────────────────────────────────────────────── *@
            <PreviewSection Key="@_SelectedKey" SelectedLanguage="@SelectedLanguage"
                            PreviewOverrides="@(_VariablesSection?.CurrentPreviewOverrides ?? _EmptyOverrides)"
                            SourceDraft="@_SourceDraft"
                            TranslationDraft="@_TranslationDraft"/>

            @* ── Suggestions ──────────────────────────────────────────────── *@
            <SuggestionsSection Key="@_SelectedKey" SelectedLanguage="@SelectedLanguage" OnChanged="StateHasChanged"
                                PreviewOverrides="@(_VariablesSection?.CurrentPreviewOverrides ?? _EmptyOverrides)"/>

            @* ── Translation comments ─────────────────────────────────────── *@
            <CommentThread Key="@_SelectedKey" Scope="CommentScope.Translation" LanguageId="@SelectedLanguage"
                           Label="@Loc.T(Localization.Translate.KeyDetail.commentsLabel, new Dictionary<string, object> { ["language"] = SelectedLanguage })" OnChanged="StateHasChanged"/>

            @* ── Variables ────────────────────────────────────────────────── *@
            <VariablesSection @ref="_VariablesSection" Key="@_SelectedKey" OnChanged="StateHasChanged"/>

            @* ── Key comments ─────────────────────────────────────────────── *@
            <CommentThread Key="@_SelectedKey" Scope="CommentScope.Key" Label="@Loc.T(Localization.Translate.KeyDetail.keyComments)" OnChanged="StateHasChanged"/>

        </div>
    }

</div>

@code {
    [Parameter] public string        SelectedLanguage { get; set; } = "";
    [Parameter] public Guid?         SelectedKeyId    { get; set; }
    [Parameter] public EventCallback OnKeyDeleted     { get; set; }

    private VariablesSection? _VariablesSection;
    private string            _SourceDraft      = "";
    private string            _TranslationDraft = "";
    private bool              _ConfirmDeleteKey;

    private bool _IsAdmin => _ProjectState.CurrentUser.IsAdmin;

    protected override void OnParametersSet()
    {
        // Reset the delete confirmation whenever a different key is opened.
        _ConfirmDeleteKey = false;
    }

    private async Task DeleteKey()
    {
        if (_SelectedKey == null) return;
        _ProjectState.DeleteKey(_SelectedKey.Id);
        _ConfirmDeleteKey = false;
        await OnKeyDeleted.InvokeAsync();
    }

    private static readonly Dictionary<Guid, string> _EmptyOverrides = new();

    protected override void OnInitialized()
    {
        // Refresh when the project data changes (e.g. a sync just computed conflicts) so the conflict
        // box and status tag update immediately, even when the affected key is already open.
        _ProjectState.ProjectDataChanged += OnProjectDataChanged;
    }

    private void OnProjectDataChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _ProjectState.ProjectDataChanged -= OnProjectDataChanged;
    }

    private void OnDraftChanged((string source, string translation) drafts)
    {
        _SourceDraft      = drafts.source;
        _TranslationDraft = drafts.translation;
    }

    private LocLocalizationKey? _SelectedKey => SelectedKeyId == null ? null : _ProjectState.CurrentProject!.Keys.Find(k => k.Id == SelectedKeyId);

    private string FullKeyName(LocLocalizationKey key)
    {
        LocProject   project = _ProjectState.CurrentProject!;
        LocCategory? cat     = project.Categories.Find(c => c.Id == key.CategoryId);
        if (cat == null) return key.KeyName;

        List<string> parts   = [cat.Name];
        LocCategory  current = cat;
        while (current.ParentCategoryId != null)
        {
            LocCategory? parent = project.Categories.Find(c => c.Id == current.ParentCategoryId);
            if (parent == null) break;
            parts.Insert(0, parent.Name);
            current = parent;
        }
        return $"{string.Join("/", parts)}.{key.KeyName}";
    }

    private string _StatusTagLabel
    {
        get
        {
            LocLocalizationKey key = _SelectedKey!;
            if (key.Flags.Any(f => f.Type == FlagType.NeedsReview)) return "Needs review";
            LocKeyTranslation? t = key.Translations.Find(tr => tr.LanguageId == SelectedLanguage);
            if (t == null || (string.IsNullOrEmpty(t.Text) && t.Suggestions.Count == 0)) return "Untranslated";
            if (!string.IsNullOrEmpty(t.Text) && t.SourceChanged) return "Needs review";
            return t.Status switch
            {
                TranslationStatus.Approved  => "Approved",
                TranslationStatus.Suggested => "Suggested",
                _                           => "Draft",
            };
        }
    }

    private string _StatusTagClass => _StatusTagLabel switch
    {
        "Approved"     => "kd-status-ok",
        "Needs review" => "kd-status-warn",
        "Untranslated" => "kd-status-empty",
        _              => "kd-status-draft",
    };

    private string LocalizedStatus(string label) => label switch
    {
        "Needs review" => Loc.T(Localization.Translate.KeyDetail.statusNeedsReview),
        "Untranslated" => Loc.T(Localization.Translate.KeyDetail.statusUntranslated),
        "Approved"     => Loc.T(Localization.Translate.KeyDetail.statusApproved),
        "Suggested"    => Loc.T(Localization.Translate.KeyDetail.statusSuggested),
        _              => Loc.T(Localization.Translate.KeyDetail.statusDraft),
    };

}
