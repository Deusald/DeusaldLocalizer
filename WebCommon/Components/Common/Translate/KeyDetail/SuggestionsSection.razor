@namespace DeusaldLocalizerWeb.Components.Common
@inject ProjectStateService _ProjectState

@{ List<LocTranslationSuggestion> suggestions = _SuggestionsForLanguage; }

@if (suggestions.Count > 0)
{
    <div class="ss-root">
        <div class="ss-label">Community suggestions</div>

        <div class="ss-list">
            @foreach (LocTranslationSuggestion suggestion in suggestions)
            {
                LocTranslationSuggestion s          = suggestion;
                int                      score      = s.Votes.Sum(v => v.Value);
                int                      myVote     = s.Votes.Find(v => v.UserId == _ProjectState.CurrentUser.UserId)?.Value ?? 0;
                string                   authorName = AuthorName(s.AuthorId);
                string                   preview    = VariablePreviewService.Render(s.Text, Key.Variables, PreviewOverrides, _ProjectState.CurrentProject!.Enums);

                <div class="ss-item">
                    <div class="ss-vote">
                        <button class="ss-vote-btn @(myVote == 1 ? "active" : "")" @onclick="() => Vote(s, 1)">
                            <i class="bi bi-caret-up-fill"></i>
                        </button>
                        <span class="ss-vote-score">@score</span>
                        <button class="ss-vote-btn @(myVote == -1 ? "active" : "")" @onclick="() => Vote(s, -1)">
                            <i class="bi bi-caret-down-fill"></i>
                        </button>
                    </div>

                    <div class="ss-content">
                        <div class="ss-text"><MentionText Text="@s.Text"/></div>
                        @if (preview != s.Text)
                        {
                            <div class="ss-preview">@((MarkupString)PreviewHtmlSanitizer.ToSafeHtml(preview))</div>
                        }
                        <div class="ss-meta">
                            <span class="ss-avatar" style="background:@AvatarColor(s.AuthorId)">@Initial(authorName)</span>
                            <span class="ss-author">@authorName</span>
                            <span class="ss-dot">·</span>
                            <span class="ss-time">@RelativeTime(s.CreatedAt)</span>
                        </div>
                    </div>

                    @if (_CanAccept)
                    {
                        <div class="ss-review-actions">
                            <button class="ss-accept-btn" @onclick="() => Accept(s)">Accept</button>
                            <button class="ss-reject-btn" @onclick="() => Reject(s)">Reject</button>
                        </div>
                    }
                </div>

                <div class="ss-comments">
                    <button class="ss-comments-toggle" @onclick="() => ToggleComments(s.Id)">
                        <i class="bi @(_ExpandedComments.Contains(s.Id) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                        <i class="bi bi-chat-left-text"></i>
                        @{ int commentCount = s.Comments.Count; }
                        <span>@(commentCount > 0 ? $"{commentCount} comment{(commentCount == 1 ? "" : "s")}" : "Comment")</span>
                    </button>
                    @if (_ExpandedComments.Contains(s.Id))
                    {
                        <CommentThread Key="Key" Scope="CommentScope.Suggestion" LanguageId="@SelectedLanguage"
                                       SuggestionId="s.Id" Label="Discussion" Compact="true" OnChanged="OnCommentsChanged"/>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public LocLocalizationKey       Key              { get; set; } = null!;
    [Parameter] public string                   SelectedLanguage { get; set; } = "";
    [Parameter] public EventCallback            OnChanged        { get; set; }
    [Parameter] public Dictionary<Guid, string> PreviewOverrides { get; set; } = new();

    private bool _CanAccept => _ProjectState.CurrentUser.IsAdmin
                               || _ProjectState.CurrentUser.ReviewLanguagePermissions.Contains(SelectedLanguage);

    private readonly HashSet<Guid> _ExpandedComments = new();

    private void ToggleComments(Guid suggestionId)
    {
        if (!_ExpandedComments.Add(suggestionId)) _ExpandedComments.Remove(suggestionId);
    }

    private async Task OnCommentsChanged() => await OnChanged.InvokeAsync();

    private List<LocTranslationSuggestion> _SuggestionsForLanguage =>
        Key.Translations.FirstOrDefault(t => t.LanguageId == SelectedLanguage)?.Suggestions
            .OrderByDescending(s => s.Votes.Sum(v => v.Value))
            .ToList() ?? [];

    private void Vote(LocTranslationSuggestion suggestion, int value)
    {
        LocSuggestionVote? existing = suggestion.Votes.Find(v => v.UserId == _ProjectState.CurrentUser.UserId);
        if (existing != null)
        {
            if (existing.Value == value)
            {
                suggestion.Votes.Remove(existing); // toggle off
            }
            else
            {
                existing.Value  = value;
                existing.CastAt = DateTime.UtcNow;
            }
        }
        else
        {
            suggestion.Votes.Add(new LocSuggestionVote
            {
                UserId = _ProjectState.CurrentUser.UserId,
                Value  = value,
            });
        }

        _ProjectState.RecordSuggestionVoted(Key.Id, SelectedLanguage, suggestion);
        OnChanged.InvokeAsync();
    }

    private void Accept(LocTranslationSuggestion suggestion)
    {
        LocKeyTranslation? translation = Key.Translations.Find(t => t.LanguageId == SelectedLanguage);
        if (translation == null) return;

        // Hash of the text before accepting — lets the server/client detect a concurrent edit.
        string oldDestHash = TextHashHelper.Compute(translation.Text);

        translation.Text          = suggestion.Text;
        translation.Status        = TranslationStatus.Approved;
        translation.SourceChanged = false;
        translation.UpdatedAt     = DateTime.UtcNow;

        // Accepting a suggestion means the translator has reviewed the current source —
        // stamp the hash so this translation is considered up-to-date.
        LocKeyTranslation? src = Key.Translations.Find(t => t.LanguageId == _ProjectState.CurrentProject!.Metadata.MainLanguageId);
        translation.BaseTextHash = TextHashHelper.Compute(src?.Text ?? "");

        translation.Suggestions.Remove(suggestion);
        Key.UpdatedAt = DateTime.UtcNow;

        // The translation update and the suggestion removal are one action — group them so they stay atomic.
        using (_ProjectState.BeginChangeGroup("accept suggestion"))
        {
            _ProjectState.RecordTranslationUpdated(Key.Id, translation, oldDestHash);
            _ProjectState.RecordSuggestionRemoved(Key.Id, SelectedLanguage, suggestion.Id);
        }
        OnChanged.InvokeAsync();
    }

    private void Reject(LocTranslationSuggestion suggestion)
    {
        LocKeyTranslation? translation = Key.Translations.Find(t => t.LanguageId == SelectedLanguage);
        if (translation == null) return;

        translation.Suggestions.Remove(suggestion);
        Key.UpdatedAt = DateTime.UtcNow;

        // Rejecting may also clear the source-changed flag; keep both changes atomic when it does.
        using (_ProjectState.BeginChangeGroup("reject suggestion"))
        {
            _ProjectState.RecordSuggestionRemoved(Key.Id, SelectedLanguage, suggestion.Id);

            // If nothing is left pending and the current translation is approved, clear the flag.
            if (translation.Suggestions.Count == 0 && translation.Status == TranslationStatus.Approved && translation.SourceChanged)
            {
                translation.SourceChanged = false;
                _ProjectState.RecordTranslationUpdated(Key.Id, translation);
            }
        }

        OnChanged.InvokeAsync();
    }

    private string AuthorName(Guid authorId)
    {
        LocProjectMember? member = _ProjectState.CurrentProject!.ProjectMembers.Find(m => m.UserId == authorId);
        if (member != null) return member.Username;
        return authorId == _ProjectState.CurrentUser.UserId ? _ProjectState.CurrentUser.Username : "Unknown";
    }

    private static string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper();

    private static readonly string[] _AvatarPalette = ["#5b6cff", "#3ad98a", "#ff6b6b", "#f5a623", "#a78bfa", "#36c5f0"];

    private static string AvatarColor(Guid userId)
    {
        int idx = Math.Abs(userId.GetHashCode()) % _AvatarPalette.Length;
        return _AvatarPalette[idx];
    }

    private static string RelativeTime(DateTime time)
    {
        TimeSpan diff = DateTime.UtcNow - time;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d";
        return time.ToString("MMM d");
    }

}
