@namespace DeusaldLocalizerWeb.Components.Common
@inject ProjectStateService _ProjectState
@inject UiLocalizationService Loc

@if (_Visible)
{
    <div class="afm-backdrop" @onclick="Close"></div>

    <div class="afm-box" @onclick:stopPropagation="true">
        <div class="afm-header">
            <span class="afm-title">@Loc.T(Localization.Translate.KeyDetail.AddFlag.addFlag)</span>
            <button class="afm-close" @onclick="Close"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="afm-body">
            <div class="afm-field">
                <label class="afm-label">@Loc.T(Localization.Translate.KeyDetail.AddFlag.labelFlagType)</label>
                <div class="afm-types">
                    @foreach (FlagType type in EnumExtensions.IterateAllValues<FlagType>())
                    {
                        FlagType t = type;
                        <button class="afm-type @(_Selected == t ? "active" : "")" @onclick="() => _Selected = t">
                            <i class="bi @FlagIcon(t)"></i>
                            <span>@FlagLabel(t)</span>
                        </button>
                    }
                </div>
            </div>

            <div class="afm-field">
                <label class="afm-label">@Loc.T(Localization.Translate.KeyDetail.AddFlag.labelNote) <span class="afm-label-hint">@Loc.T(Localization.Translate.KeyDetail.AddFlag.hintOptional)</span></label>
                <textarea class="afm-input" placeholder="@Loc.T(Localization.Translate.KeyDetail.AddFlag.placeholderNote)"
                          @bind="_Note" @bind:event="oninput" rows="3" maxlength="300"></textarea>
            </div>
        </div>

        <div class="afm-footer">
            <button class="afm-btn afm-btn-ghost" @onclick="Close">@Loc.T(Localization.Common.Buttons.cancel)</button>
            <button class="afm-btn afm-btn-primary" @onclick="Confirm" disabled="@(_Selected == null)">@Loc.T(Localization.Translate.KeyDetail.AddFlag.addFlag)</button>
        </div>
    </div>
}

@code {
    [Parameter] public LocLocalizationKey Key     { get; set; } = null!;
    [Parameter] public EventCallback      OnAdded { get; set; }

    private bool      _Visible;
    private FlagType? _Selected;
    private string    _Note = "";

    public void Show()
    {
        _Selected = null;
        _Note     = "";
        _Visible  = true;
        StateHasChanged();
    }

    private void Close() => _Visible = false;

    private void Confirm()
    {
        if (_Selected == null) return;

        LocKeyFlag newFlag = new LocKeyFlag
        {
            Type      = _Selected.Value,
            Note      = _Note.Trim(),
            CreatedBy = _ProjectState.CurrentUser.UserId,
        };

        Key.Flags.Add(newFlag);
        _ProjectState.RecordFlagAdded(Key.Id, newFlag);

        _Visible = false;
        OnAdded.InvokeAsync();
    }

    private string FlagLabel(FlagType type) => type switch
    {
        FlagType.NeedsReview    => Loc.T(Localization.Translate.KeyDetail.AddFlag.flagNeedsReview),
        FlagType.Outdated       => Loc.T(Localization.Translate.KeyDetail.AddFlag.flagOutdated),
        FlagType.DoNotTranslate => Loc.T(Localization.Translate.KeyDetail.AddFlag.flagDoNotTranslate),
        FlagType.InProgress     => Loc.T(Localization.Translate.KeyDetail.AddFlag.flagInProgress),
        FlagType.Disputed       => Loc.T(Localization.Translate.KeyDetail.AddFlag.flagDisputed),
        _                       => type.ToString(),
    };

    private static string FlagIcon(FlagType type) => type switch
    {
        FlagType.NeedsReview    => "bi-flag",
        FlagType.Outdated       => "bi-clock-history",
        FlagType.DoNotTranslate => "bi-slash-circle",
        FlagType.InProgress     => "bi-hourglass-split",
        FlagType.Disputed       => "bi-exclamation-triangle",
        _                       => "bi-flag",
    };

}
