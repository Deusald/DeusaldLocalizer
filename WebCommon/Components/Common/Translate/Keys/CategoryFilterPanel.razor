@namespace DeusaldLocalizerWeb.Components.Common
@inject ProjectStateService _ProjectState
@inject UiLocalizationService Loc

<div class="cfp-root">

    @if (!_Expanded)
    {
        <button class="cfp-trigger" @onclick="() => _Expanded = true">
            <i class="bi bi-funnel cfp-trigger-icon"></i>
            <span class="cfp-trigger-label">@_TriggerLabel</span>
            <i class="bi bi-chevron-down cfp-trigger-chevron"></i>
        </button>
    }
    else
    {
        <div class="cfp-panel">
            <div class="cfp-panel-header">
                <span class="cfp-panel-title">@Loc.T(Localization.Translate.Keys.CategoryFilter.filterByCategory)</span>
                <div class="cfp-panel-actions">
                    @if (_HasNested)
                    {
                        <button class="cfp-collapse-btn" title="@Loc.T(Localization.Translate.Keys.CategoryFilter.collapseAll)" @onclick="CollapseAll">
                            <i class="bi bi-arrows-collapse"></i>
                        </button>
                        <button class="cfp-collapse-btn" title="@Loc.T(Localization.Translate.Keys.CategoryFilter.expandAll)" @onclick="ExpandAll">
                            <i class="bi bi-arrows-expand"></i>
                        </button>
                    }
                    @if (SelectedCategoryIds.Count > 0)
                    {
                        <button class="cfp-clear-btn" @onclick="ClearAll">@Loc.T(Localization.Common.Buttons.clear)</button>
                    }
                    <button class="cfp-collapse-btn" @onclick="() => _Expanded = false">
                        <i class="bi bi-chevron-up"></i>
                    </button>
                </div>
            </div>

            <div class="cfp-list">
                @if (_ProjectState.CurrentProject!.Categories.Count == 0)
                {
                    <div class="cfp-empty">@Loc.T(Localization.Translate.Keys.CategoryFilter.noCategoriesYet)</div>
                }
                else
                {
                    @foreach (CategoryRow row in _FlattenedCategories)
                    {
                        bool        active      = SelectedCategoryIds.Contains(row.Category.Id);
                        LocCategory cat         = row.Category;
                        bool        hasKeys     = CategoryHasKeys(cat.Id);
                        bool        hasChildren = row.HasChildren;
                        bool        collapsed   = _Collapsed.Contains(cat.Id);

                        <div class="cfp-row"
                             style="padding-left:@(row.Depth * 16)px"
                             title="@cat.Description"
                             @onmouseenter="() => _HoveredId = cat.Id"
                             @onmouseleave="() => _HoveredId = null">
                            @if (hasChildren)
                            {
                                <button class="cfp-caret" @onclick="() => ToggleCollapse(cat.Id)"
                                        title="@(collapsed ? Loc.T(Localization.Translate.Keys.CategoryFilter.expand) : Loc.T(Localization.Translate.Keys.CategoryFilter.collapse))">
                                    <i class="bi @(collapsed ? "bi-chevron-right" : "bi-chevron-down")"></i>
                                </button>
                            }
                            else
                            {
                                <span class="cfp-caret-spacer"></span>
                            }
                            <button class="cfp-item @(active ? "active" : "")"
                                    title="@Loc.T(Localization.Translate.Keys.CategoryFilter.rightClickSelectOnly)"
                                    @onclick="e => OnItemClick(e, cat.Id)"
                                    @oncontextmenu="e => OnItemContextMenu(e, cat.Id)"
                                    @oncontextmenu:preventDefault="true">
                                <span class="cfp-item-check">@(active ? "✓" : "")</span>
                                <span class="cfp-item-name">@cat.Name</span>
                            </button>

                            @if (_IsAdmin && _HoveredId == cat.Id)
                            {
                                <div class="cfp-row-actions">
                                    <button class="cfp-row-action-btn" title="@Loc.T(Localization.Translate.Keys.CategoryFilter.editCategory)"
                                            @onclick="() => _NewCategoryModal?.EditCategory(cat)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="cfp-row-action-btn cfp-row-action-btn-danger"
                                            title="@(hasKeys ? Loc.T(Localization.Translate.Keys.CategoryFilter.cannotDeleteHasKeys) : Loc.T(Localization.Translate.Keys.CategoryFilter.deleteCategory))"
                                            disabled="@hasKeys"
                                            @onclick="() => DeleteCategory(cat)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @if (_IsAdmin)
            {
                <button class="cfp-add-btn" @onclick="() => _NewCategoryModal?.Show(_ActiveParentCategory)">
                    <i class="bi bi-plus-lg"></i> @Loc.T(Localization.Translate.Keys.CategoryFilter.addCategory)
                </button>
            }
        </div>
    }

</div>

<NewCategoryModal @ref="_NewCategoryModal" OnCreated="StateHasChanged"/>

@code {
    [Parameter] public HashSet<Guid>                SelectedCategoryIds     { get; set; } = new();
    [Parameter] public EventCallback<HashSet<Guid>> OnChanged               { get; set; }
    [Parameter] public EventCallback<Guid?>         OnActiveCategoryChanged { get; set; }

    private bool              _Expanded;
    private NewCategoryModal? _NewCategoryModal;
    private Guid?             _HoveredId;
    private Guid?             _ActiveCategoryId;
    private HashSet<Guid>     _Collapsed = new();

    private bool _IsAdmin => _ProjectState.CurrentUser.IsAdmin;

    /// <summary>The most recently selected category, preselected as the parent when adding a new category.</summary>
    private LocCategory? _ActiveParentCategory =>
        _ActiveCategoryId == null
            ? null
            : _ProjectState.CurrentProject!.Categories.Find(c => c.Id == _ActiveCategoryId);

    private bool CategoryHasKeys(Guid categoryId) =>
        _ProjectState.CurrentProject!.Keys.Any(k => k.CategoryId == categoryId);

    private async Task DeleteCategory(LocCategory category)
    {
        if (CategoryHasKeys(category.Id)) return; // guarded in UI too, but double-check here

        LocProject project = _ProjectState.CurrentProject!;
        project.Categories.Remove(category);
        _ProjectState.RecordCategoryRemoved(category);

        if (_ActiveCategoryId == category.Id) _ActiveCategoryId = null;

        if (SelectedCategoryIds.Contains(category.Id))
        {
            HashSet<Guid> next = new HashSet<Guid>(SelectedCategoryIds);
            next.Remove(category.Id);
            await OnChanged.InvokeAsync(next);
        }

        _HoveredId = null;
    }

    private sealed record CategoryRow(LocCategory Category, int Depth, string ParentPath, bool HasChildren);

    private List<CategoryRow> _FlattenedCategories
    {
        get
        {
            List<LocCategory> all  = _ProjectState.CurrentProject!.Categories;
            List<CategoryRow> rows = new List<CategoryRow>();

            void Walk(Guid? parentId, int depth, string parentPath)
            {
                IOrderedEnumerable<LocCategory> children = all
                                                           .Where(c => c.ParentCategoryId == parentId)
                                                           .OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase);

                foreach (LocCategory cat in children)
                {
                    bool hasChildren = all.Any(c => c.ParentCategoryId == cat.Id);
                    rows.Add(new CategoryRow(cat, depth, parentPath, hasChildren));
                    string nextPath = string.IsNullOrEmpty(parentPath) ? cat.Name : $"{parentPath}/{cat.Name}";
                    if (hasChildren && !_Collapsed.Contains(cat.Id))
                        Walk(cat.Id, depth + 1, nextPath);
                }
            }

            Walk(null, 0, "");
            return rows;
        }
    }

    private void ToggleCollapse(Guid id)
    {
        if (!_Collapsed.Remove(id)) _Collapsed.Add(id);
    }

    private bool _HasNested =>
        _ProjectState.CurrentProject!.Categories.Any(c => c.ParentCategoryId != null);

    private void CollapseAll()
    {
        List<LocCategory> all = _ProjectState.CurrentProject!.Categories;
        _Collapsed = new HashSet<Guid>(all.Where(parent => all.Any(c => c.ParentCategoryId == parent.Id))
                                          .Select(parent => parent.Id));
    }

    private void ExpandAll()
    {
        _Collapsed.Clear();
    }

    /// <summary>A category id together with all of its descendant ids.</summary>
    private List<Guid> SubtreeIds(Guid id)
    {
        List<LocCategory> all    = _ProjectState.CurrentProject!.Categories;
        List<Guid>        result = new List<Guid> { id };

        void Collect(Guid parentId)
        {
            foreach (LocCategory child in all.Where(c => c.ParentCategoryId == parentId))
            {
                result.Add(child.Id);
                Collect(child.Id);
            }
        }

        Collect(id);
        return result;
    }

    private string _TriggerLabel
    {
        get
        {
            if (SelectedCategoryIds.Count == 0) return Loc.T(Localization.Translate.Keys.CategoryFilter.allCategories);
            if (SelectedCategoryIds.Count == 1)
            {
                Guid         id  = SelectedCategoryIds.First();
                LocCategory? cat = _ProjectState.CurrentProject!.Categories.Find(c => c.Id == id);
                return cat == null ? Loc.T(Localization.Translate.Keys.CategoryFilter.oneCategory) : CategoryPath(cat);
            }
            return Loc.T(Localization.Translate.Keys.CategoryFilter.manyCategories, new Dictionary<string, object> { ["count"] = SelectedCategoryIds.Count });
        }
    }

    private string CategoryPath(LocCategory cat)
    {
        List<string> parts   = new List<string> { cat.Name };
        LocProject   project = _ProjectState.CurrentProject!;
        LocCategory  current = cat;
        while (current.ParentCategoryId != null)
        {
            LocCategory? parent = project.Categories.Find(c => c.Id == current.ParentCategoryId);
            if (parent == null) break;
            parts.Insert(0, parent.Name);
            current = parent;
        }
        return string.Join("/", parts);
    }

    /// <summary>Left click selects only this category; ctrl+click toggles it additively.</summary>
    private Task OnItemClick(MouseEventArgs e, Guid id) =>
        e.CtrlKey ? ToggleAdditive(id) : SelectOnly(id);

    /// <summary>Select only this category, deselecting everything else; clicking it again clears the selection.</summary>
    private async Task SelectOnly(Guid id)
    {
        HashSet<Guid> target   = new HashSet<Guid> { id };
        bool          deselect = SelectedCategoryIds.SetEquals(target);

        _ActiveCategoryId = deselect ? (Guid?)null : id;
        await OnChanged.InvokeAsync(deselect ? new HashSet<Guid>() : target);
        await OnActiveCategoryChanged.InvokeAsync(_ActiveCategoryId);
    }

    /// <summary>Ctrl+click: toggle this category in the selection, leaving the others untouched.</summary>
    private async Task ToggleAdditive(Guid id)
    {
        HashSet<Guid> next   = new HashSet<Guid>(SelectedCategoryIds);
        bool          turnOn = !next.Contains(id);

        if (turnOn) next.Add(id);
        else next.Remove(id);

        _ActiveCategoryId = turnOn ? id : (Guid?)null;
        await OnChanged.InvokeAsync(next);
        await OnActiveCategoryChanged.InvokeAsync(_ActiveCategoryId);
    }

    /// <summary>Right click selects this category and its descendants; ctrl+right click adds them additively.</summary>
    private Task OnItemContextMenu(MouseEventArgs e, Guid id) =>
        e.CtrlKey ? AddSubtree(id) : SelectSubtree(id);

    /// <summary>Select this category together with all of its descendants, deselecting everything else; clicking it again clears the selection.</summary>
    private async Task SelectSubtree(Guid id)
    {
        HashSet<Guid> target   = new HashSet<Guid>(SubtreeIds(id));
        bool          deselect = SelectedCategoryIds.SetEquals(target);

        _ActiveCategoryId = deselect ? (Guid?)null : id;
        await OnChanged.InvokeAsync(deselect ? new HashSet<Guid>() : target);
        await OnActiveCategoryChanged.InvokeAsync(_ActiveCategoryId);
    }

    /// <summary>Ctrl+right click: add this category and its descendants to the selection, leaving the others untouched.</summary>
    private async Task AddSubtree(Guid id)
    {
        HashSet<Guid> next = new HashSet<Guid>(SelectedCategoryIds);
        next.UnionWith(SubtreeIds(id));

        _ActiveCategoryId = id;
        await OnChanged.InvokeAsync(next);
        await OnActiveCategoryChanged.InvokeAsync(id);
    }

    private async Task ClearAll()
    {
        _ActiveCategoryId = null;
        await OnChanged.InvokeAsync(new HashSet<Guid>());
        await OnActiveCategoryChanged.InvokeAsync(null);
    }

}
