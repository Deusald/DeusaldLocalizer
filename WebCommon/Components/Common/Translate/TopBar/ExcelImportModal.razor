@namespace DeusaldLocalizerWeb.Components.Common
@inject ProjectStateService _ProjectState
@inject IExcelInterop       _Excel
@inject UiLocalizationService Loc

@if (_Visible)
{
    <div class="im-backdrop" @onclick="Close"></div>

    <div class="im-box" @onclick:stopPropagation="true">

        <div class="im-header">
            <span class="im-title">@Loc.T(Localization.Translate.TopBar.ExcelImport.title)</span>
            <button class="im-close" @onclick="Close"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="im-body">

            @if (_Result == null && !_IsImporting)
            {
                <div class="im-desc">
                    @Loc.T(Localization.Translate.TopBar.ExcelImport.desc)
                </div>

                @if (_Error != null)
                {
                    <div class="im-alert im-alert-error">
                        <i class="bi bi-exclamation-triangle"></i> @_Error
                    </div>
                }

                @* ── What to update ─────────────────────────────────────── *@
                <div class="im-section">
                    <div class="im-section-header">
                        <span class="im-section-title">@Loc.T(Localization.Translate.TopBar.ExcelImport.updateFromSheet)</span>
                        <button class="im-linkbtn" @onclick="ToggleAll">
                            @(_AllSelected ? Loc.T(Localization.Translate.TopBar.ExcelImport.deselectAll) : Loc.T(Localization.Translate.TopBar.ExcelImport.selectAll))
                        </button>
                    </div>
                    <label class="im-check"><input type="checkbox" @bind="_Options.CreateNewKeys"/><span>@Loc.T(Localization.Translate.TopBar.ExcelImport.createNewKeys)</span></label>
                    <label class="im-check"><input type="checkbox" @bind="_Options.UpdateCategories"/><span>@Loc.T(Localization.Translate.TopBar.ExcelImport.updateCategories) <span class="im-check-hint">@Loc.T(Localization.Translate.TopBar.ExcelImport.updateCategoriesHint)</span></span></label>
                    <label class="im-check"><input type="checkbox" @bind="_Options.UpdateDescriptions"/><span>@Loc.T(Localization.Translate.TopBar.ExcelImport.updateDescriptions)</span></label>
                    <label class="im-check"><input type="checkbox" @bind="_Options.UpdateTags"/><span>@Loc.T(Localization.Translate.TopBar.ExcelImport.updateTags)</span></label>
                    <label class="im-check"><input type="checkbox" @bind="_Options.UpdateMaxLength"/><span>@Loc.T(Localization.Translate.TopBar.ExcelImport.updateMaxLength)</span></label>
                    <label class="im-check"><input type="checkbox" @bind="_Options.UpdateSourceText"/><span>@Loc.T(Localization.Translate.TopBar.ExcelImport.updateSourceText)</span></label>
                </div>

                @* ── How to import translations ─────────────────────────── *@
                <div class="im-section">
                    <span class="im-section-title">@Loc.T(Localization.Translate.TopBar.ExcelImport.translationsImportAs)</span>
                    <div class="im-seg">
                        <button class="im-seg-btn @(_Options.ImportAsSuggestions ? "active" : "")"
                                @onclick="() => _Options.ImportAsSuggestions = true">@Loc.T(Localization.Translate.TopBar.ExcelImport.suggestions)
                        </button>
                        <button class="im-seg-btn @(!_Options.ImportAsSuggestions ? "active" : "")"
                                @onclick="() => _Options.ImportAsSuggestions = false">@Loc.T(Localization.Translate.TopBar.ExcelImport.directText)
                        </button>
                    </div>
                    <div class="im-section-hint">
                        @(_Options.ImportAsSuggestions
                            ? Loc.T(Localization.Translate.TopBar.ExcelImport.hintSuggestions)
                            : Loc.T(Localization.Translate.TopBar.ExcelImport.hintDirect))
                    </div>
                </div>

                <button class="im-pick-btn" @onclick="PickAndImport">
                    <i class="bi bi-file-earmark-spreadsheet"></i>
                    @Loc.T(Localization.Translate.TopBar.ExcelImport.chooseFile)
                </button>
            }
            else if (_IsImporting)
            {
                <div class="im-progress">
                    <span class="im-spinner"></span>
                    <span>@Loc.T(Localization.Translate.TopBar.ExcelImport.importing)</span>
                </div>
            }
            else if (_Result != null)
            {
                <div class="im-result">
                    @if (_Result.KeysCreated > 0)
                    {
                        <div class="im-stat"><span class="im-stat-value">@_Result.KeysCreated</span><span class="im-stat-label">@Loc.T(Localization.Translate.TopBar.ExcelImport.keysCreated)</span></div>
                    }
                    <div class="im-stat"><span class="im-stat-value">@_Result.KeysUpdated</span><span class="im-stat-label">@Loc.T(Localization.Translate.TopBar.ExcelImport.keysUpdated)</span></div>
                    @if (_Result.TranslationsUpdated > 0)
                    {
                        <div class="im-stat"><span class="im-stat-value">@_Result.TranslationsUpdated</span><span class="im-stat-label">@Loc.T(Localization.Translate.TopBar.ExcelImport.translationsSet)</span></div>
                    }
                    @if (_Result.SuggestionsAdded > 0)
                    {
                        <div class="im-stat"><span class="im-stat-value">@_Result.SuggestionsAdded</span><span class="im-stat-label">@Loc.T(Localization.Translate.TopBar.ExcelImport.suggestionsAdded)</span></div>
                    }
                    @if (_Result.CategoriesCreated > 0)
                    {
                        <div class="im-stat"><span class="im-stat-value">@_Result.CategoriesCreated</span><span class="im-stat-label">@Loc.T(Localization.Translate.TopBar.ExcelImport.categoriesCreated)</span></div>
                    }
                    @if (_Result.KeysSkipped > 0)
                    {
                        <div class="im-stat im-stat-warn"><span class="im-stat-value">@_Result.KeysSkipped</span><span class="im-stat-label">@Loc.T(Localization.Translate.TopBar.ExcelImport.rowsSkipped)</span></div>
                    }
                </div>

                @if (_Result.Warnings.Count > 0)
                {
                    <div class="im-warnings">
                        @foreach (string w in _Result.Warnings)
                        {
                            <div class="im-warning-row"><i class="bi bi-exclamation-triangle"></i> @w</div>
                        }
                    </div>
                }
            }

        </div>

        @if (_Result != null)
        {
            <div class="im-footer">
                <button class="im-btn im-btn-ghost" @onclick="Reset">@Loc.T(Localization.Translate.TopBar.ExcelImport.importAnother)</button>
                <button class="im-btn im-btn-primary" @onclick="Close">@Loc.T(Localization.Translate.TopBar.ExcelImport.done)</button>
            </div>
        }

    </div>
}

@code {
    private bool             _Visible;
    private bool             _IsImporting;
    private ImportResult?    _Result;
    private string?          _Error;
    private LocImportOptions _Options = new();

    private bool _AllSelected =>
        _Options is { CreateNewKeys: true, UpdateCategories: true, UpdateDescriptions: true, UpdateTags: true, UpdateMaxLength: true, UpdateSourceText: true };

    public void Show()
    {
        _Result      = null;
        _Error       = null;
        _IsImporting = false;
        _Options     = new LocImportOptions();
        _Visible     = true;
        StateHasChanged();
    }

    private void Close() => _Visible = false;

    private void Reset()
    {
        _Result      = null;
        _Error       = null;
        _IsImporting = false;
    }

    private void ToggleAll()
    {
        bool value = !_AllSelected;
        _Options.CreateNewKeys      = value;
        _Options.UpdateCategories   = value;
        _Options.UpdateDescriptions = value;
        _Options.UpdateTags         = value;
        _Options.UpdateMaxLength    = value;
        _Options.UpdateSourceText   = value;
    }

    private async Task PickAndImport()
    {
        _Error = null;

        try
        {
            Stream? picked = await _Excel.PickXlsxForReadAsync();
            if (picked == null) return;

            _IsImporting = true;
            StateHasChanged();

            await Task.Yield(); // let the spinner render

            await using Stream stream = picked;
            _Result = LocalizationImportService.ImportFromStream(
                stream,
                _ProjectState.CurrentProject!,
                _ProjectState.CurrentUser.UserId,
                _Options);

            // Replay each mutation into the change log (in order) so it populates
            // UncommitedChanges when online, marks keys dirty and flags the app dirty.
            foreach (ImportedChange change in _Result.Changes)
                RecordChange(change);
        }
        catch (Exception ex)
        {
            _Error = Loc.T(Localization.Translate.TopBar.ExcelImport.importFailed, new Dictionary<string, object> { ["msg"] = ex.Message });
        }
        finally
        {
            _IsImporting = false;
            StateHasChanged();
        }
    }

    private void RecordChange(ImportedChange change)
    {
        switch (change.Kind)
        {
            case ImportChangeKind.CategoryAdded:         _ProjectState.RecordCategoryAdded(change.Category!); break;
            case ImportChangeKind.KeyAdded:              _ProjectState.RecordKeyAdded(change.Key!); break;
            case ImportChangeKind.KeyCategoryChanged:    _ProjectState.RecordKeyCategoryChanged(change.Key!); break;
            case ImportChangeKind.KeyDescriptionChanged: _ProjectState.RecordKeyDescriptionChanged(change.Key!); break;
            case ImportChangeKind.KeyMaxLengthChanged:   _ProjectState.RecordKeyMaxLengthChanged(change.Key!); break;
            case ImportChangeKind.TagAdded:              _ProjectState.RecordTagAdded(change.KeyId, change.Tag); break;
            case ImportChangeKind.TagRemoved:            _ProjectState.RecordTagRemoved(change.KeyId, change.Tag); break;
            case ImportChangeKind.TranslationUpdated:    _ProjectState.RecordTranslationUpdated(change.KeyId, change.Translation!, change.PrevDestHash); break;
            case ImportChangeKind.SuggestionAdded:       _ProjectState.RecordSuggestionAdded(change.KeyId, change.LanguageId, change.Suggestion!); break;
        }
    }

}
