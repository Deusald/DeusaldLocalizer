@namespace DeusaldLocalizerWeb.Components.Common
@inject UiLocalizationService Loc

@if (_Visible)
{
    <div class="clm-backdrop" @onclick="Cancel"></div>

    <div class="clm-box" @onclick:stopPropagation="true">
        <div class="clm-header">
            <span class="clm-title">@Loc.T(Localization.Translate.TopBar.ConfirmLeave.unsavedChanges)</span>
        </div>

        <div class="clm-body">
            <p>@Loc.T(Localization.Translate.TopBar.ConfirmLeave.unsavedChangesBody)</p>
        </div>

        <div class="clm-footer">
            <button class="clm-btn clm-btn-ghost" @onclick="Cancel">@Loc.T(Localization.Common.Buttons.cancel)</button>
            <button class="clm-btn clm-btn-danger" @onclick="DiscardAndLeave">@Loc.T(Localization.Translate.TopBar.ConfirmLeave.discardAndLeave)</button>
            <button class="clm-btn clm-btn-primary" @onclick="SaveAndLeave">@Loc.T(Localization.Translate.TopBar.ConfirmLeave.saveAndLeave)</button>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSaveAndLeave    { get; set; }
    [Parameter] public EventCallback OnDiscardAndLeave { get; set; }

    private bool _Visible;

    public void Show()
    {
        _Visible = true;
        StateHasChanged();
    }

    private void Cancel() => _Visible = false;

    private async Task SaveAndLeave()
    {
        _Visible = false;
        await OnSaveAndLeave.InvokeAsync();
    }

    private async Task DiscardAndLeave()
    {
        _Visible = false;
        await OnDiscardAndLeave.InvokeAsync();
    }

}