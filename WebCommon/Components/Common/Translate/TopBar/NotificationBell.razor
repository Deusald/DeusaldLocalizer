@namespace DeusaldLocalizerWeb.Components.Common
@inject ProjectStateService  _ProjectState
@inject IPreferencesStore    _Prefs
@inject UiLocalizationService Loc
@implements IDisposable

<div class="nb-root">
    <button class="nb-btn" @onclick="ToggleOpen" title="@Loc.T(Localization.Translate.TopBar.Notifications.mentions)">
        <i class="bi bi-bell"></i>
        @if (_UnreadCount > 0)
        {
            <span class="nb-badge">@(_UnreadCount > 9 ? "9+" : _UnreadCount.ToString())</span>
        }
    </button>

    @if (_Open)
    {
        <div class="nb-backdrop" @onclick="Close"></div>
        <div class="nb-panel" @onclick:stopPropagation="true">
            <div class="nb-panel-header">
                <span>@Loc.T(Localization.Translate.TopBar.Notifications.mentions)</span>
                @if (_Notifications.Count > 0)
                {
                    <span class="nb-panel-count">@_Notifications.Count</span>
                }
            </div>

            @if (_Notifications.Count == 0)
            {
                <div class="nb-empty">
                    <i class="bi bi-bell-slash"></i>
                    <span>@Loc.T(Localization.Translate.TopBar.Notifications.noMentions)</span>
                </div>
            }
            else
            {
                <div class="nb-list">
                    @foreach (MentionNotification notification in _Notifications)
                    {
                        MentionNotification n      = notification;
                        bool                unread = _UnseenAtOpen.Contains(n.Id);
                        <button class="nb-item @(unread ? "nb-unread" : "")" @onclick="() => Open(n)">
                            <span class="nb-avatar" style="background:@AvatarColor(n.AuthorId)">@Initial(AuthorName(n.AuthorId))</span>
                            <span class="nb-body">
                                <span class="nb-meta">
                                    <span class="nb-author">@AuthorName(n.AuthorId)</span>
                                    <span class="nb-source">@SourceLabel(n.Source)</span>
                                    <span class="nb-time">@RelativeTime(n.CreatedAt)</span>
                                </span>
                                <span class="nb-text">@n.Text</span>
                                <span class="nb-key">@KeyName(n.KeyId)</span>
                            </span>
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool                      _Open;
    private List<MentionNotification> _Notifications = new();
    private HashSet<Guid>             _Seen         = new(); // ids the user has already looked at (persisted)
    private HashSet<Guid>             _UnseenAtOpen = new(); // ids that were unseen when the panel was opened (highlight)

    private int _UnreadCount => _Notifications.Count(n => !_Seen.Contains(n.Id));

    protected override void OnInitialized()
    {
        _ProjectState.ProjectChanged     += OnProjectChanged;
        _ProjectState.ProjectDataChanged += Refresh;
        LoadSeen();
        Rebuild();
    }

    private void OnProjectChanged()
    {
        LoadSeen();
        Refresh();
    }

    private void Refresh()
    {
        Rebuild();
        InvokeAsync(StateHasChanged);
    }

    private void Rebuild()
    {
        if (_ProjectState.CurrentProject is null)
        {
            _Notifications = new List<MentionNotification>();
            return;
        }
        _Notifications = MentionNotifications.Build(_ProjectState.CurrentProject, _ProjectState.CurrentUser);
    }

    private void ToggleOpen()
    {
        _Open = !_Open;
        if (_Open)
        {
            // Remember which ids were unseen so the panel can still highlight them, then mark everything seen.
            _UnseenAtOpen = _Notifications.Where(n => !_Seen.Contains(n.Id)).Select(n => n.Id).ToHashSet();
            MarkSeen();
        }
    }

    private void Close() => _Open = false;

    private void Open(MentionNotification n)
    {
        _Open = false;
        string lang = string.IsNullOrEmpty(n.LanguageId)
                          ? _ProjectState.CurrentProject!.Metadata.MainLanguageId
                          : n.LanguageId;
        _ProjectState.RequestOpenKey(n.KeyId, lang);
    }

    // ── Seen ids (local, per project + user) ───────────────────────────────────
    // Tracked by id rather than a timestamp so a comment authored before the user's last visit but only
    // now synced in still counts as unseen.

    private string _SeenKey =>
        $"notif-seen:{_ProjectState.CurrentProject!.Metadata.Id}:{_ProjectState.CurrentUser.UserId}";

    private void LoadSeen()
    {
        if (_ProjectState.CurrentProject is null) { _Seen = new HashSet<Guid>(); return; }
        string raw = _Prefs.Get(_SeenKey, "");
        _Seen = raw.Split(',', StringSplitOptions.RemoveEmptyEntries)
                   .Select(s => Guid.TryParse(s, out Guid g) ? g : Guid.Empty)
                   .Where(g => g != Guid.Empty)
                   .ToHashSet();
    }

    private void MarkSeen()
    {
        if (_ProjectState.CurrentProject is null) return;
        // Replace with exactly the currently-relevant ids so the stored set stays bounded.
        _Seen = _Notifications.Select(n => n.Id).ToHashSet();
        _Prefs.Set(_SeenKey, string.Join(",", _Seen));
    }

    // ── Display helpers ────────────────────────────────────────────────────────

    private string AuthorName(Guid authorId)
    {
        LocProjectMember? member = _ProjectState.CurrentProject!.ProjectMembers.Find(m => m.UserId == authorId);
        return member?.Username ?? Loc.T(Localization.Translate.TopBar.Notifications.unknown);
    }

    private string KeyName(Guid keyId)
    {
        LocLocalizationKey? key = _ProjectState.CurrentProject!.Keys.Find(k => k.Id == keyId);
        return key?.KeyName ?? Loc.T(Localization.Translate.TopBar.Notifications.removedKey);
    }

    private string SourceLabel(MentionSource source) => source switch
    {
        MentionSource.KeyComment         => Loc.T(Localization.Translate.TopBar.Notifications.commented),
        MentionSource.TranslationComment => Loc.T(Localization.Translate.TopBar.Notifications.commented),
        MentionSource.SuggestionComment  => Loc.T(Localization.Translate.TopBar.Notifications.replied),
        MentionSource.Suggestion         => Loc.T(Localization.Translate.TopBar.Notifications.suggested),
        _                                => "",
    };

    private static string Initial(string name) => string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper();

    private static readonly string[] _AvatarPalette = ["#5b6cff", "#3ad98a", "#ff6b6b", "#f5a623", "#a78bfa", "#36c5f0"];

    private static string AvatarColor(Guid userId)
    {
        int idx = Math.Abs(userId.GetHashCode()) % _AvatarPalette.Length;
        return _AvatarPalette[idx];
    }

    private string RelativeTime(DateTime time)
    {
        TimeSpan diff = DateTime.UtcNow - time;
        if (diff.TotalMinutes < 1) return Loc.T(Localization.Translate.TopBar.Notifications.justNow);
        if (diff.TotalHours < 1) return Loc.T(Localization.Translate.TopBar.Notifications.minutesAgo, new Dictionary<string, object> { ["count"] = (int)diff.TotalMinutes });
        if (diff.TotalDays < 1) return Loc.T(Localization.Translate.TopBar.Notifications.hoursAgo, new Dictionary<string, object> { ["count"] = (int)diff.TotalHours });
        if (diff.TotalDays < 30) return Loc.T(Localization.Translate.TopBar.Notifications.daysAgo, new Dictionary<string, object> { ["count"] = (int)diff.TotalDays });
        return time.ToString("MMM d");
    }

    public void Dispose()
    {
        _ProjectState.ProjectChanged     -= OnProjectChanged;
        _ProjectState.ProjectDataChanged -= Refresh;
    }
}
