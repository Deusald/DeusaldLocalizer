@namespace DeusaldLocalizerWeb.Components.Common
@inject ProjectStateService  _ProjectState
@inject UiLocalizationService Loc

@if (_Visible)
{
    <div class="um-backdrop" @onclick="Close"></div>

    <div class="um-box" @onclick:stopPropagation="true">

        <div class="um-header">
            <span class="um-title">@Loc.T(Localization.Translate.TopBar.Users.collaborators)</span>
            <button class="um-close" @onclick="Close"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="um-section">
            <div class="um-section-header">
                <span class="um-section-label">@Loc.T(Localization.Translate.TopBar.Users.members) (@_ProjectState.CurrentProject!.ProjectMembers.Count)</span>
                @if (_IsAdmin && !_FormOpen)
                {
                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="StartAdd">
                        <i class="bi bi-plus-lg"></i> @Loc.T(Localization.Translate.TopBar.Users.addMember)
                    </button>
                }
            </div>

            @if (_FormOpen)
            {
                <div class="um-form">
                    <div class="um-form-title">@(_EditingMember == null ? Loc.T(Localization.Translate.TopBar.Users.addMember) : Loc.T(Localization.Translate.TopBar.Users.editMember))</div>

                    <div class="um-field">
                        <label class="um-label">@Loc.T(Localization.Translate.TopBar.Users.username)</label>
                        <input class="um-input" type="text" placeholder="@Loc.T(Localization.Translate.TopBar.Users.usernamePlaceholder)"
                               @bind="_Username" @bind:event="oninput" maxlength="60"/>
                    </div>

                    <div class="um-field">
                        <label class="um-label">
                            @Loc.T(Localization.Translate.TopBar.Users.reviewLanguages) <span class="um-label-hint">@Loc.T(Localization.Translate.TopBar.Users.reviewLanguagesHint)</span>
                        </label>
                        @if (_ProjectState.CurrentProject.Metadata.Languages.Count == 0)
                        {
                            <div class="um-empty">@Loc.T(Localization.Translate.TopBar.Users.noLanguagesYet)</div>
                        }
                        else
                        {
                            <div class="um-perm-flags">
                                @foreach (string code in _ProjectState.CurrentProject.Metadata.Languages)
                                {
                                    string c      = code;
                                    bool   active = _SelectedLangs.Contains(c);
                                    <button class="um-perm-chip @(active ? "active" : "")"
                                            @onclick="() => ToggleLang(c)" title="@c">
                                        @LangLabel(c)
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @if (_EditingMember != null)
                    {
                        <div class="um-field">
                            <label class="um-ban-toggle">
                                <input type="checkbox" @bind="_IsBanned"/>
                                <span>@Loc.T(Localization.Translate.TopBar.Users.banned) <span class="um-label-hint">@Loc.T(Localization.Translate.TopBar.Users.bannedHint)</span></span>
                            </label>
                        </div>
                    }

                    <div class="um-form-footer">
                        <button class="um-btn um-btn-ghost" @onclick="CloseForm">@Loc.T(Localization.Common.Buttons.cancel)</button>
                        <button class="um-btn um-btn-primary" @onclick="Confirm"
                                disabled="@(string.IsNullOrWhiteSpace(_Username))">
                            @(_EditingMember == null ? Loc.T(Localization.Translate.TopBar.Users.addMember) : Loc.T(Localization.Translate.TopBar.Users.saveChanges))
                        </button>
                    </div>
                </div>
            }

            @if (_TokenError != null)
            {
                <div class="dl-alert dl-alert-error um-token-error">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>@_TokenError</span>
                </div>
            }

            <div class="um-member-list">
                @if (_ProjectState.CurrentProject.ProjectMembers.Count == 0)
                {
                    <div class="um-empty">@Loc.T(Localization.Translate.TopBar.Users.noMembersYet)</div>
                }
                @foreach (LocProjectMember member in _ProjectState.CurrentProject.ProjectMembers)
                {
                    bool isSelf = member.UserId == _ProjectState.CurrentUser.UserId;

                    <div class="um-member-row">
                        <div class="um-member-avatar" style="background:@AvatarColor(member.UserId)">
                            @Initial(member.Username)
                        </div>
                        <div class="um-member-info">
                            <div class="um-member-name">
                                @member.Username
                                @if (isSelf)
                                {
                                    <span class="um-member-you">@Loc.T(Localization.Translate.TopBar.Users.you)</span>
                                }
                                @if (member.IsAdmin)
                                {
                                    <span class="um-member-badge um-badge-admin">@Loc.T(Localization.Translate.TopBar.Users.admin)</span>
                                }
                                @if (member.IsBanned)
                                {
                                    <span class="um-member-badge um-badge-banned">@Loc.T(Localization.Translate.TopBar.Users.bannedBadge)</span>
                                }
                            </div>
                            <div class="um-perm-readonly">@PermissionsSummary(member)</div>
                        </div>

                        <div class="um-member-actions">
                            @if (_PendingDeleteId == member.UserId)
                            {
                                <span class="um-delete-confirm">
                                    <span>@Loc.T(Localization.Translate.TopBar.Users.deleteMemberConfirm, new Dictionary<string, object> { ["name"] = member.Username })</span>
                                    <button class="um-confirm-yes" @onclick="() => ConfirmDelete(member)">@Loc.T(Localization.Common.Buttons.delete)</button>
                                    <button class="um-confirm-no" @onclick="() => _PendingDeleteId = null">@Loc.T(Localization.Common.Buttons.cancel)</button>
                                </span>
                            }
                            else
                            {
                                @if (isSelf && !member.IsOfflineUser)
                                {
                                    <button class="um-edit-btn" title="@Loc.T(Localization.Translate.TopBar.Users.regenerateMyToken)"
                                            @onclick="RegenerateToken">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                }
                                @if (_IsAdmin && !isSelf)
                                {
                                    <button class="um-edit-btn" title="@Loc.T(Localization.Translate.TopBar.Users.editMember)" @onclick="() => StartEdit(member)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @if (!member.IsOfflineUser)
                                    {
                                        <button class="um-edit-btn" title="@Loc.T(Localization.Translate.TopBar.Users.resetAccessToken)"
                                                @onclick="() => ResetToken(member)">
                                            <i class="bi bi-key"></i>
                                        </button>
                                        <button class="um-edit-btn um-delete-btn" title="@Loc.T(Localization.Translate.TopBar.Users.deleteMember)"
                                                @onclick="() => _PendingDeleteId = member.UserId">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (_IsAdmin)
        {
            <div class="um-section um-maint-section">
                <div class="um-section-header">
                    <span class="um-section-label">@Loc.T(Localization.Translate.TopBar.Users.commentMaintenance)</span>
                </div>

                <p class="um-maint-hint">@Loc.T(Localization.Translate.TopBar.Users.commentMaintenanceHint)</p>

                <div class="um-maint-row">
                    <input class="um-input um-maint-amount" type="number" min="1" max="999"
                           @bind="_ClearAmount" @bind:event="oninput"/>
                    <select class="um-input um-maint-unit" @bind="_ClearUnit">
                        <option value="Days">@Loc.T(Localization.Translate.TopBar.Users.days)</option>
                        <option value="Months">@Loc.T(Localization.Translate.TopBar.Users.months)</option>
                    </select>

                    @if (_ConfirmClear)
                    {
                        <span class="um-delete-confirm">
                            <span>@Loc.T(Localization.Translate.TopBar.Users.clearConfirmPrefix) @_ClearAmount @(_ClearUnit == "Months" ? Loc.T(Localization.Translate.TopBar.Users.month) : Loc.T(Localization.Translate.TopBar.Users.day))@(_ClearAmount == 1 ? "" : "s")@Loc.T(Localization.Translate.TopBar.Users.clearConfirmSuffix)</span>
                            <button class="um-confirm-yes" @onclick="ClearOldComments">@Loc.T(Localization.Common.Buttons.clear)</button>
                            <button class="um-confirm-no" @onclick="() => _ConfirmClear = false">@Loc.T(Localization.Common.Buttons.cancel)</button>
                        </span>
                    }
                    else
                    {
                        <button class="um-btn um-btn-primary um-btn-sm" @onclick="() => { _ConfirmClear = true; _ClearResult = null; }"
                                disabled="@(_ClearAmount < 1)">
                            <i class="bi bi-trash"></i> @Loc.T(Localization.Translate.TopBar.Users.clearOldComments)
                        </button>
                    }
                </div>

                @if (_ClearResult != null)
                {
                    <div class="dl-alert dl-alert-success um-maint-result">
                        <i class="bi bi-check-circle"></i>
                        <span>@_ClearResult</span>
                    </div>
                }
            </div>
        }

    </div>

    <AccessTokenModal @ref="_AccessTokenModal"/>
}

@code {
    private bool    _Visible;
    private bool    _FormOpen;
    private string  _Username = "";
    private bool    _IsBanned;
    private string? _TokenError;

    private HashSet<string>   _SelectedLangs = new();
    private LocProjectMember? _EditingMember;
    private AccessTokenModal? _AccessTokenModal;
    private Guid?             _PendingDeleteId;

    private int     _ClearAmount = 30;
    private string  _ClearUnit   = "Days";
    private bool    _ConfirmClear;
    private string? _ClearResult;

    private bool _IsAdmin => _ProjectState.CurrentUser.IsAdmin;

    private void ClearOldComments()
    {
        _ConfirmClear = false;

        DateTime cutoff = _ClearUnit == "Months"
                              ? DateTime.UtcNow.AddMonths(-_ClearAmount)
                              : DateTime.UtcNow.AddDays(-_ClearAmount);

        int cleared = _ProjectState.ClearCommentsOlderThan(cutoff);
        _ClearResult = cleared == 0
                           ? Loc.T(Localization.Translate.TopBar.Users.noCommentsOldEnough)
                           : Loc.T(Localization.Translate.TopBar.Users.clearedComments, new Dictionary<string, object> { ["count"] = cleared });
    }

    private void ConfirmDelete(LocProjectMember member)
    {
        _ProjectState.DeleteMember(member.UserId);
        _PendingDeleteId = null;
    }

    public void Show()
    {
        CloseForm();
        _TokenError      = null;
        _PendingDeleteId = null;
        _ConfirmClear    = false;
        _ClearResult     = null;
        _Visible         = true;
        StateHasChanged();
    }

    private void Close() => _Visible = false;

    // ── Add / Edit form ──────────────────────────────────────────────────────

    private void StartAdd()
    {
        _EditingMember = null;
        _Username      = "";
        _SelectedLangs = new HashSet<string>();
        _IsBanned      = false;
        _FormOpen      = true;
    }

    private void StartEdit(LocProjectMember member)
    {
        _EditingMember = member;
        _Username      = member.Username;
        _SelectedLangs = new HashSet<string>(member.ReviewLanguagePermissions);
        _IsBanned      = member.IsBanned;
        _FormOpen      = true;
    }

    private void CloseForm()
    {
        _FormOpen      = false;
        _EditingMember = null;
        _Username      = "";
        _SelectedLangs = new HashSet<string>();
        _IsBanned      = false;
    }

    private void ToggleLang(string code)
    {
        if (!_SelectedLangs.Add(code)) _SelectedLangs.Remove(code);
    }

    private void Confirm()
    {
        string name = _Username.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;

        LocProject project = _ProjectState.CurrentProject!;

        if (_EditingMember == null)
        {
            // Issue a random one-time sign-in token shown to the admin below; the member is forced to
            // rotate it to their own token on first sign-in (MustResetAccessToken). The token is never
            // derived from public data (like the username), so nobody with repo access can guess it.
            string initialToken = AccessTokenService.GenerateToken();

            LocProjectMember member = new()
            {
                UserId                    = Guid.NewGuid(),
                Username                  = name,
                ReviewLanguagePermissions = [.._SelectedLangs],
                IsAdmin                   = false,
                IsBanned                  = false,
                HashedAccessToken         = AccessTokenService.HashToken(initialToken),
                MustResetAccessToken      = true
            };

            project.ProjectMembers.Add(member);
            _ProjectState.RecordMemberAdded(member);

            CloseForm();
            _AccessTokenModal?.Show(initialToken, Loc.T(Localization.Translate.TopBar.Users.memberSignInTokenTitle),
                Loc.T(Localization.Translate.TopBar.Users.memberSignInTokenBody, new Dictionary<string, object> { ["name"] = name }));
            return;
        }

        // Record one change per actually-changed field (compared before mutating).
        bool usernameChanged = _EditingMember.Username != name;
        bool langsChanged    = !_EditingMember.ReviewLanguagePermissions.SetEquals(_SelectedLangs);
        bool bannedChanged   = _EditingMember.IsBanned != _IsBanned;

        _EditingMember.Username                  = name;
        _EditingMember.ReviewLanguagePermissions = [.._SelectedLangs];
        _EditingMember.IsBanned                  = _IsBanned;

        if (usernameChanged) _ProjectState.RecordMemberUsernameChanged(_EditingMember);
        if (langsChanged) _ProjectState.RecordMemberReviewPermissionsChanged(_EditingMember);
        if (bannedChanged) _ProjectState.RecordMemberBanStatusChanged(_EditingMember);

        CloseForm();
    }

    // ── Access token ─────────────────────────────────────────────────────────

    /// <summary>
    /// User rotates their own access token to a fresh random one. The change is pushed to the server
    /// immediately, authenticated with the current token — the new one cannot push itself because the
    /// server does not know it yet. Only once the server accepts it is the new token adopted.
    /// </summary>
    private async Task RegenerateToken()
    {
        _TokenError = null;

        InitialTokenResult result = await _ProjectState.RegenerateOwnTokenAsync();

        if (result.RawToken == null)
        {
            _TokenError = result.Error ?? Loc.T(Localization.Translate.TopBar.Users.couldNotRegenerateToken);
            StateHasChanged();
            return;
        }

        _AccessTokenModal?.Show(result.RawToken, Loc.T(Localization.Translate.TopBar.Users.newAccessTokenTitle),
            Loc.T(Localization.Translate.TopBar.Users.newAccessTokenBody));
    }

    /// <summary>Admin resets a member to a fresh random one-time token they must rotate on next sign-in.</summary>
    private void ResetToken(LocProjectMember member)
    {
        string newToken = AccessTokenService.GenerateToken();

        member.HashedAccessToken    = AccessTokenService.HashToken(newToken);
        member.MustResetAccessToken = true;
        _ProjectState.RecordMemberAccessTokenChanged(member);
        _ProjectState.RecordMemberMustResetChanged(member);

        _AccessTokenModal?.Show(newToken, Loc.T(Localization.Translate.TopBar.Users.accessTokenResetTitle),
            Loc.T(Localization.Translate.TopBar.Users.accessTokenResetBody, new Dictionary<string, object> { ["name"] = member.Username }));
    }

    // ── Display helpers ──────────────────────────────────────────────────────

    private static string Initial(string name) =>
        string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper();

    private static readonly string[] _AvatarPalette =
        ["#5b6cff", "#3ad98a", "#ff6b6b", "#f5a623", "#a78bfa", "#36c5f0"];

    private static string AvatarColor(Guid userId)
    {
        int idx = Math.Abs(userId.GetHashCode()) % _AvatarPalette.Length;
        return _AvatarPalette[idx];
    }

    private static string LangLabel(string code)
    {
        LanguageDisplay disp = CultureService.DescribeLanguage(code);
        return $"{disp.Flag} {disp.Name}";
    }

    private string PermissionsSummary(LocProjectMember member)
    {
        if (member.IsAdmin) return Loc.T(Localization.Translate.TopBar.Users.adminFullAccess);
        if (member.ReviewLanguagePermissions.Count == 0) return Loc.T(Localization.Translate.TopBar.Users.noReviewLanguages);
        return string.Join(", ", member.ReviewLanguagePermissions.Select(LangLabel));
    }

}
