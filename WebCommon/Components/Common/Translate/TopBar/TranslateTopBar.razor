@namespace DeusaldLocalizerWeb.Components.Common
@inject ProjectStateService  _ProjectState
@inject NavigationManager    _Nav
@inject IJSRuntime           _Js
@inject UiLocalizationService Loc
@implements IAsyncDisposable

@{ if (!_ProjectState.HasProject) return; }

<div class="ttb-root">

    <div class="ttb-left">
        <button class="ttb-back-btn" @onclick="GoHome" title="@Loc.T(Localization.Translate.TopBar.backToProjects)">
            <i class="bi bi-chevron-left"></i>
        </button>

        <div class="ttb-logo-orbs">
            <div class="ttb-orb ttb-orb-1"></div>
            <div class="ttb-orb ttb-orb-2"></div>
            <div class="ttb-orb ttb-orb-3"></div>
        </div>
        <span class="ttb-project-name">@_ProjectState.CurrentProject!.Metadata.Name</span>
        <span class="ttb-sep">/</span>
        <span class="ttb-translating">
            @Loc.T(Localization.Translate.TopBar.translatingInto) <strong>@_LanguageLabel</strong>
        </span>
    </div>

    <div class="ttb-right">

        @if (_ProjectState.IsDirty)
        {
            <button class="ttb-save-btn" @onclick="Save">
                <i class="bi bi-cloud-arrow-up"></i> @Loc.T(Localization.Common.Buttons.save)
            </button>
        }
        <span class="ttb-status-pill @(_ProjectState.IsDirty ? "ttb-status-warn" : "ttb-status-ok")">
            <span class="ttb-status-dot"></span>
            @(_ProjectState.IsDirty ? Loc.T(Localization.Translate.TopBar.unsaved) : Loc.T(Localization.Translate.TopBar.saved))
        </span>

        @if (_IsOnline)
        {
            <button class="ttb-save-btn" @onclick="Sync" disabled="@_Busy" title="@Loc.T(Localization.Translate.TopBar.syncFromServer)">
                <i class="bi bi-arrow-repeat"></i> @Loc.T(Localization.Translate.TopBar.sync)
            </button>
            <button class="ttb-save-btn" @onclick="Push"
                    disabled="@(_Busy || _UncommittedCount == 0)"
                    title="@(_ProjectState.HasSyncConflicts ? Loc.T(Localization.Translate.TopBar.resolveConflictsBeforePushing) : Loc.T(Localization.Translate.TopBar.pushChangesToServer))">
                <i class="bi bi-cloud-arrow-up-fill"></i> @Loc.T(Localization.Translate.TopBar.push)@(_UncommittedCount > 0 ? $" ({_UncommittedCount})" : "")
            </button>

            @if (_ProjectState.HasSyncConflicts)
            {
                <button class="ttb-status-pill ttb-status-pill-btn ttb-status-warn" title="@_ConflictTooltip"
                        @onclick="() => _ConflictsModal?.Show()">
                    <span class="ttb-status-dot"></span>
                    @_ProjectState.SyncConflicts.Count @(_ProjectState.SyncConflicts.Count == 1 ? Loc.T(Localization.Translate.TopBar.conflict) : Loc.T(Localization.Translate.TopBar.conflicts))
                </button>
            }
            @if (_ProjectState.LastPullChanges.Count > 0)
            {
                <button class="ttb-status-pill ttb-status-pill-btn ttb-status-info" title="@Loc.T(Localization.Translate.TopBar.seeWhatLastSyncChanged)"
                        @onclick="() => _RecentChangesModal?.Show()">
                    <i class="bi bi-clock-history"></i>
                    @Loc.T(Localization.Translate.TopBar.recentChanges) (@_ProjectState.LastPullChanges.Count)
                </button>
            }
            @if (!string.IsNullOrEmpty(_StatusMessage))
            {
                <span class="ttb-sync-msg">@_StatusMessage</span>
            }
        }

        <button class="ttb-history-btn" @onclick="Undo" disabled="@(!_ProjectState.CanUndo)"
                title="@(_ProjectState.CanUndo ? Loc.T(Localization.Translate.TopBar.undoLabel, new Dictionary<string, object> { ["label"] = _ProjectState.UndoLabel }) : Loc.T(Localization.Translate.TopBar.nothingToUndo))">
            <i class="bi bi-arrow-counterclockwise"></i>
        </button>
        <button class="ttb-history-btn" @onclick="Redo" disabled="@(!_ProjectState.CanRedo)"
                title="@(_ProjectState.CanRedo ? Loc.T(Localization.Translate.TopBar.redoLabel, new Dictionary<string, object> { ["label"] = _ProjectState.RedoLabel }) : Loc.T(Localization.Translate.TopBar.nothingToRedo))">
            <i class="bi bi-arrow-clockwise"></i>
        </button>

        <button class="ttb-history-btn" @onclick="() => _ExportModal?.Show()" title="@Loc.T(Localization.Translate.TopBar.export)">
            <i class="bi bi-file-earmark-arrow-down"></i>
        </button>

        <button class="ttb-history-btn" @onclick="() => _ImportModal?.Show()" title="@Loc.T(Localization.Translate.TopBar.importFromExcel)">
            <i class="bi bi-file-earmark-arrow-up"></i>
        </button>

        @if (_IsOnline)
        {
            <span class="ttb-status-pill @(_UncommittedCount == 0 ? "ttb-status-ok" : "ttb-status-warn")"
                  title="@(_UncommittedCount == 0 ? Loc.T(Localization.Translate.TopBar.allLocalChangesOnServer) : Loc.T(Localization.Translate.TopBar.changesNotPushed, new Dictionary<string, object> { ["count"] = _UncommittedCount }))">
                <span class="ttb-status-dot"></span>
                @(_UncommittedCount == 0 ? Loc.T(Localization.Translate.TopBar.committed) : Loc.T(Localization.Translate.TopBar.uncommitted))
            </span>
        }
        else if (_UncommittedMode)
        {
            <button class="ttb-status-pill ttb-status-pill-btn @(_UncommittedCount == 0 ? "ttb-status-ok" : "ttb-status-warn")"
                    title="@(_UncommittedCount == 0 ? Loc.T(Localization.Translate.TopBar.uncommittedModeNoChanges) : Loc.T(Localization.Translate.TopBar.changesWaitingToApply, new Dictionary<string, object> { ["count"] = _UncommittedCount }))"
                    @onclick="() => _ProjectUncommittedChangesModal?.Show()">
                <span class="ttb-status-dot"></span>
                @(_UncommittedCount == 0 ? Loc.T(Localization.Translate.TopBar.committed) : Loc.T(Localization.Translate.TopBar.uncommittedCount, new Dictionary<string, object> { ["count"] = _UncommittedCount }))
            </button>
        }

        <button class="ttb-history-btn" @onclick="() => _ProjectUncommittedChangesModal?.Show()" title="@Loc.T(Localization.Translate.TopBar.uncommittedChanges)">
            <i class="bi bi-clock-history"></i>
        </button>

        @if (_IsOnline)
        {
            <NotificationBell/>
        }

        <LanguagePicker/>

        <div class="ttb-avatars" @onclick="OpenUsersModal">
            @foreach (LocProjectMember member in _VisibleMembers)
            {
                <div class="ttb-avatar" style="background:@AvatarColor(member.UserId)" title="@member.Username">
                    @Initial(member.Username)
                </div>
            }
            @if (_ExtraMemberCount > 0)
            {
                <div class="ttb-avatar ttb-avatar-extra">+@_ExtraMemberCount</div>
            }
        </div>

    </div>

</div>

<UsersModal @ref="_UsersModal"/>
<ConfirmLeaveModal @ref="_ConfirmLeaveModal" OnSaveAndLeave="SaveAndLeave" OnDiscardAndLeave="DiscardAndLeave"/>
<ProjectUncommittedChangesModal @ref="_ProjectUncommittedChangesModal"/>
<ConflictsModal @ref="_ConflictsModal"/>
<RecentChangesModal @ref="_RecentChangesModal"/>
<ExcelImportModal @ref="_ImportModal"/>
<ExportModal @ref="_ExportModal"/>

@code {
    [Parameter] public string SelectedLanguage { get; set; } = "";

    private UsersModal?                     _UsersModal;
    private ConfirmLeaveModal?              _ConfirmLeaveModal;
    private ProjectUncommittedChangesModal? _ProjectUncommittedChangesModal;
    private ConflictsModal?                 _ConflictsModal;
    private RecentChangesModal?             _RecentChangesModal;
    private ExcelImportModal?               _ImportModal;
    private ExportModal?                    _ExportModal;

    private const int _MAX_VISIBLE_AVATARS = 3;

    private bool    _Busy;
    private string? _StatusMessage;

    private IJSObjectReference?                     _ShortcutsModule;
    private DotNetObjectReference<TranslateTopBar>? _SelfRef;

    private bool _IsOnline         => _ProjectState.CurrentProject!.Metadata.IsOnline;
    private bool _UncommittedMode  => _ProjectState.CurrentProject!.Metadata.UncommittedMode;
    private int  _UncommittedCount => _ProjectState.CurrentProject!.UncommitedChanges.Count;

    private string _ConflictTooltip =>
        string.Join("\n", _ProjectState.SyncConflicts.Select(c => c.Message));

    private string _LanguageLabel
    {
        get
        {
            CultureService.SplitVariant(SelectedLanguage, out string baseCode, out string? variant);
            CultureEntry? entry = CultureService.FindByCode(baseCode);
            string        name  = entry?.EnglishName ?? baseCode;
            return variant != null ? $"{name} · {variant}" : name;
        }
    }

    private List<LocProjectMember> _ProjectMembers => _ProjectState.CurrentProject!.Metadata.IsOnline
                                                          ? _ProjectState.CurrentProject!.ProjectMembers
                                                          : [.._ProjectState.CurrentProject!.ProjectMembers, LocProjectMember.OfflineMember];

    private List<LocProjectMember> _VisibleMembers =>
        _ProjectMembers.Count <= _MAX_VISIBLE_AVATARS
            ? _ProjectMembers
            : _ProjectMembers.GetRange(0, _MAX_VISIBLE_AVATARS);

    private int _ExtraMemberCount =>
        Math.Max(0, _ProjectMembers.Count - _MAX_VISIBLE_AVATARS);

    private static string Initial(string name) =>
        string.IsNullOrEmpty(name) ? "?" : name.Substring(0, 1).ToUpper();

    private static readonly string[] _AvatarPalette =
        ["#5b6cff", "#3ad98a", "#ff6b6b", "#f5a623", "#a78bfa", "#36c5f0"];

    private static string AvatarColor(Guid userId)
    {
        int idx = Math.Abs(userId.GetHashCode()) % _AvatarPalette.Length;
        return _AvatarPalette[idx];
    }

    protected override void OnInitialized()
    {
        _ProjectState.DirtyStateChanged  += OnDirty;
        _ProjectState.ProjectDataChanged += OnDirty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Document-level Ctrl/Cmd+Z / +Y is handled in JS (Blazor has no global keydown) and calls back into
        // Undo/Redo below. The module ships from WebCommon, so both the MAUI and web hosts load the same file.
        _SelfRef         = DotNetObjectReference.Create(this);
        _ShortcutsModule = await _Js.InvokeAsync<IJSObjectReference>("import", "./_content/DeusaldLocalizerWebCommon/js/shortcuts.js");
        await _ShortcutsModule.InvokeVoidAsync("register", _SelfRef);
    }

    // Re-render is driven by ProjectDataChanged -> OnDirty (InvokeAsync-marshalled), which both the button
    // click and the JS shortcut reach, so these just delegate.
    [JSInvokable]
    public void Undo() => _ProjectState.UndoLastChange();

    [JSInvokable]
    public void Redo() => _ProjectState.RedoLastChange();

    private async Task Sync()
    {
        _Busy          = true;
        _StatusMessage = Loc.T(Localization.Translate.TopBar.syncing);
        StateHasChanged();

        SyncOperationResult result = await _ProjectState.SyncAsync();
        _StatusMessage = result.Outcome switch
        {
            SyncOutcome.UpToDate      => Loc.T(Localization.Translate.TopBar.upToDate),
            SyncOutcome.Updated       => Loc.T(Localization.Translate.TopBar.syncedFiles, new Dictionary<string, object> { ["count"] = result.ChangedFiles }) + ConflictSuffix(result.Conflicts),
            SyncOutcome.FullResync    => Loc.T(Localization.Translate.TopBar.resynced) + ConflictSuffix(result.Conflicts),
            SyncOutcome.NoCredentials => Loc.T(Localization.Translate.TopBar.signInRequired),
            SyncOutcome.NotOnline     => Loc.T(Localization.Translate.TopBar.offlineProject),
            _                         => Loc.T(Localization.Translate.TopBar.syncFailed) + (result.Error is null ? "" : $": {result.Error}"),
        };

        _Busy = false;
        StateHasChanged();
    }

    private async Task Push()
    {
        // Something already blocks the push — explain why instead of firing a doomed request.
        if (_ProjectState.HasSyncConflicts)
        {
            _ConflictsModal?.Show();
            return;
        }

        _Busy          = true;
        _StatusMessage = Loc.T(Localization.Translate.TopBar.pushing);
        StateHasChanged();

        PushOperationResult result = await _ProjectState.PushAsync();
        _StatusMessage = result.Outcome switch
        {
            PushOutcome.Success            => Loc.T(Localization.Translate.TopBar.pushed),
            PushOutcome.BlockedByConflicts => Loc.T(Localization.Translate.TopBar.resolveConflictsFirst, new Dictionary<string, object> { ["count"] = result.Conflicts }),
            PushOutcome.Conflict           => Loc.T(Localization.Translate.TopBar.pushRejectedResolve, new Dictionary<string, object> { ["count"] = result.Conflicts }),
            PushOutcome.NoCredentials      => Loc.T(Localization.Translate.TopBar.signInRequired),
            PushOutcome.NotOnline          => Loc.T(Localization.Translate.TopBar.offlineProject),
            _                              => Loc.T(Localization.Translate.TopBar.pushFailed) + (result.Message is null ? "" : $": {result.Message}"),
        };

        switch (result.Outcome)
        {
            case PushOutcome.BlockedByConflicts:
                _ConflictsModal?.Show();
                break;
            case PushOutcome.Conflict:
                _ConflictsModal?.ShowError(Loc.T(Localization.Translate.TopBar.pushRejectedNewerChanges));
                break;
            case PushOutcome.Failed:
                _ConflictsModal?.ShowError(result.Message ?? Loc.T(Localization.Translate.TopBar.pushRejectedByServer));
                break;
            case PushOutcome.NoCredentials:
                _ConflictsModal?.ShowError(Loc.T(Localization.Translate.TopBar.signInBeforePush));
                break;
        }

        _Busy = false;
        StateHasChanged();
    }

    private string ConflictSuffix(int conflicts) =>
        conflicts > 0 ? Loc.T(Localization.Translate.TopBar.conflictSuffix, new Dictionary<string, object> { ["count"] = conflicts }) : "";

    private void OpenUsersModal() => _UsersModal?.Show();

    private void GoHome()
    {
        if (_ProjectState.IsDirty)
        {
            _ConfirmLeaveModal?.Show();
        }
        else
        {
            LeaveAndUnload();
        }
    }

    private void LeaveAndUnload()
    {
        _ProjectState.CloseProject();
        // Navigate to the absolute base URI, not "" or "/". An empty relative path resolves against the
        // current URL (/translate) inside the MAUI WebView, so it never leaves the editor; an absolute "/"
        // ignores the web app's rewritten base href on GitHub Pages and 404s. BaseUri is correct for both.
        _Nav.NavigateTo(_Nav.BaseUri);
    }

    private async Task SaveAndLeave()
    {
        await Save();
        LeaveAndUnload();
    }

    private void DiscardAndLeave()
    {
        LeaveAndUnload();
    }

    private async Task Save()
    {
        await _ProjectState.SaveAsync();
        StateHasChanged();
    }

    private void OnDirty()
    {
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _ProjectState.DirtyStateChanged  -= OnDirty;
        _ProjectState.ProjectDataChanged -= OnDirty;

        if (_ShortcutsModule is not null)
        {
            try
            {
                await _ShortcutsModule.InvokeVoidAsync("unregister");
                await _ShortcutsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit / WebView is already gone (navigation, teardown) — nothing left to clean up.
            }
        }

        _SelfRef?.Dispose();
    }

}
