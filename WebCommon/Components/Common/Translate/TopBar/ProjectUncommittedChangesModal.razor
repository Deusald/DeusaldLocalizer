@namespace DeusaldLocalizerWeb.Components.Common
@inject ProjectStateService _ProjectState

@if (_Visible)
{
    <div class="ucm-backdrop" @onclick="Close"></div>

    <div class="ucm-box" @onclick:stopPropagation="true">

        <div class="ucm-header">
            <div class="ucm-header-left">
                <span class="ucm-title">Uncommitted changes</span>
                @if (_ProjectState.CurrentProject!.UncommitedChanges.Count > 0)
                {
                    <span class="ucm-count">@_ProjectState.CurrentProject.UncommitedChanges.Count</span>
                }
            </div>
            <div class="ucm-header-right">
                @if (_HasPending && !_Busy)
                {
                    @if (_ConfirmClearAll)
                    {
                        <span class="ucm-confirm-label">Discard all?</span>
                        <button class="ucm-confirm-yes" @onclick="ClearAll">Discard</button>
                        <button class="ucm-confirm-no" @onclick="() => _ConfirmClearAll = false">Cancel</button>
                    }
                    else
                    {
                        @if (_UncommittedMode)
                        {
                            <button class="ucm-apply-all" title="Apply every change to the project files" @onclick="ApplyAll">
                                <i class="bi bi-check2-all"></i> Apply
                            </button>
                        }
                        <button class="ucm-discard-all" @onclick="() => _ConfirmClearAll = true">
                            <i class="bi bi-trash"></i> Discard all
                        </button>
                    }
                }
                <button class="ucm-close" @onclick="Close"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>

        @if (!_ProjectState.CurrentProject.Metadata.IsOnline)
        {
            <div class="ucm-mode-bar">
                <label class="ucm-switch" title="@(_ToggleDisabled && _UncommittedMode ? "Apply or discard all changes before turning this off" : null)">
                    <input type="checkbox" checked="@_UncommittedMode" disabled="@_ToggleDisabled" @onchange="OnToggleMode"/>
                    <span class="ucm-switch-track"><span class="ucm-switch-thumb"></span></span>
                    <span class="ucm-switch-label">Uncommitted mode</span>
                </label>
                <span class="ucm-mode-hint">
                    @if (!_UncommittedMode)
                    {
                        <text>Stage edits as changes you apply in a batch.</text>
                    }
                    else if (_HasPending)
                    {
                        <text>Apply or discard all changes to turn this off.</text>
                    }
                    else
                    {
                        <text>Edits are staged until you apply them.</text>
                    }
                </span>
            </div>
        }

        @if (_ProjectState.HasSyncConflicts)
        {
            <div class="ucm-conflict-banner">
                <i class="bi bi-exclamation-triangle"></i>
                @_ProjectState.SyncConflicts.Count @(_ProjectState.SyncConflicts.Count == 1 ? "change conflicts" : "changes conflict")
                with newer server edits — sync and resolve before pushing.
            </div>
        }

        <div class="ucm-body">
            @if (_ProjectState.CurrentProject!.UncommitedChanges.Count == 0)
            {
                <div class="ucm-empty">
                    <i class="bi bi-check-circle ucm-empty-icon"></i>
                    <span>No uncommitted changes.</span>
                </div>
            }
            else
            {
                @for (int i = 0; i < _ProjectState.CurrentProject.UncommitedChanges.Count; i++)
                {
                    LocEntryChange change  = _ProjectState.CurrentProject.UncommitedChanges[i];
                    int            index   = i;
                    bool           expanded = _ExpandedIndexes.Contains(index);
                    bool           hasDetails = !string.IsNullOrEmpty(change.EntrySubId)
                                              || !string.IsNullOrEmpty(change.ChangeData)
                                              || !string.IsNullOrEmpty(change.PrevSourceHashData)
                                              || !string.IsNullOrEmpty(change.PrevDestHashData);
                    bool           conflicting = IsConflicting(change);

                    <div class="ucm-entry @(conflicting ? "ucm-entry-conflict" : "")">
                        <div class="ucm-entry-header">
                            <div class="ucm-entry-left">
                                <span class="ucm-index">@index.ToString("D4")</span>
                                <span class="ucm-type-badge @ActionClass(change.Type.ToActionType())">
                                    @CamelCaseToWords(change.Type.ToString())
                                </span>
                                <span class="ucm-entry-id" title="@change.EntryId.ToString()">
                                    @change.EntryId.ToString()[..8]…
                                </span>
                                @if (conflicting)
                                {
                                    <span class="ucm-conflict-tag" title="Conflicts with a newer server edit">
                                        <i class="bi bi-exclamation-triangle-fill"></i> conflict
                                    </span>
                                }
                            </div>
                            <div class="ucm-entry-actions">
                                @if (hasDetails)
                                {
                                    <button class="ucm-toggle" @onclick="() => ToggleExpand(index)">
                                        <i class="bi @(expanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                    </button>
                                }
                                @if (!_Busy)
                                {
                                    @if (_ConfirmRemoveIndex == index)
                                    {
                                        <button class="ucm-row-confirm-yes" title="Confirm remove" @onclick="() => Remove(index)">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button class="ucm-row-confirm-no" title="Cancel" @onclick="() => _ConfirmRemoveIndex = null">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="ucm-row-remove" title="Remove this change" @onclick="() => _ConfirmRemoveIndex = index">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                }
                            </div>
                        </div>

                        @if (expanded && hasDetails)
                        {
                            <div class="ucm-details">
                                @if (!string.IsNullOrEmpty(change.EntrySubId))
                                {
                                    <div class="ucm-detail-row">
                                        <span class="ucm-detail-label">Sub ID</span>
                                        <code class="ucm-detail-value">@change.EntrySubId</code>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(change.ChangeData))
                                {
                                    <div class="ucm-detail-row ucm-detail-row-block">
                                        <span class="ucm-detail-label">Change data</span>
                                        <pre class="ucm-detail-pre ucm-detail-new">@change.ChangeData</pre>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(change.PrevSourceHashData))
                                {
                                    <div class="ucm-detail-row ucm-detail-row-block">
                                        <span class="ucm-detail-label">Prev source hash</span>
                                        <code class="ucm-detail-pre ucm-detail-hash">@change.PrevSourceHashData</code>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(change.PrevDestHashData))
                                {
                                    <div class="ucm-detail-row ucm-detail-row-block">
                                        <span class="ucm-detail-label">Prev dest hash</span>
                                        <code class="ucm-detail-pre ucm-detail-hash">@change.PrevDestHashData</code>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

    </div>
}

@code {
    private          bool         _Visible;
    private          bool         _Busy;
    private          bool         _ConfirmClearAll;
    private          int?         _ConfirmRemoveIndex;

    private readonly HashSet<int> _ExpandedIndexes = new();

    private bool _UncommittedMode => _ProjectState.CurrentProject!.Metadata.UncommittedMode;
    private bool _HasPending      => _ProjectState.CurrentProject!.UncommitedChanges.Count > 0;

    // Off → on is always allowed; on → off only once the queue is empty (staged edits would otherwise be
    // orphaned). Also locked while an operation is in flight.
    private bool _ToggleDisabled => _Busy || (_UncommittedMode && _HasPending);

    public void Show()
    {
        _ExpandedIndexes.Clear();
        _ConfirmClearAll    = false;
        _ConfirmRemoveIndex = null;
        _Visible            = true;
        StateHasChanged();
    }

    private void Close() => _Visible = false;

    private void ToggleExpand(int index)
    {
        if (!_ExpandedIndexes.Remove(index))
            _ExpandedIndexes.Add(index);
    }

    /// <summary>Removes a single pending change, then reloads the project so the remaining changes are replayed.</summary>
    private async Task Remove(int index)
    {
        if (_Busy) return;
        _Busy = true;
        try
        {
            await _ProjectState.RemoveUncommittedChangeAsync(index);
        }
        finally
        {
            _ConfirmRemoveIndex = null;
            _ExpandedIndexes.Clear();
            _Busy = false;
        }
    }

    /// <summary>Discards every pending change, then reloads the project back to the clean server state.</summary>
    private async Task ClearAll()
    {
        if (_Busy) return;
        _Busy = true;
        try
        {
            await _ProjectState.ClearUncommittedChangesAsync();
        }
        finally
        {
            _ConfirmClearAll = false;
            _ExpandedIndexes.Clear();
            _Busy = false;
        }
    }

    /// <summary>Offline only — commits every staged change to the project files and empties the queue.</summary>
    private async Task ApplyAll()
    {
        if (_Busy) return;
        _Busy = true;
        try
        {
            await _ProjectState.ApplyUncommittedChangesAsync();
        }
        finally
        {
            _ConfirmClearAll = false;
            _ExpandedIndexes.Clear();
            _Busy = false;
        }
    }

    /// <summary>Toggles offline uncommitted mode. The state layer blocks turning it off while edits are pending.</summary>
    private async Task OnToggleMode(ChangeEventArgs e)
    {
        if (_Busy) return;
        bool enabled = e.Value is true;
        _Busy = true;
        try
        {
            await _ProjectState.SetUncommittedModeAsync(enabled);
        }
        finally
        {
            _Busy = false;
        }
    }

    /// <summary>True when this change matches a conflict detected during the last sync.</summary>
    private bool IsConflicting(LocEntryChange change) =>
        _ProjectState.SyncConflicts.Any(c => c.KeyId == change.EntryId && c.LanguageId == change.EntrySubId);

    /// <summary>Splits a CamelCase enum value into space-separated words. e.g. "StatusChanged" → "Status Changed"</summary>
    private static string CamelCaseToWords(string value) =>
        Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");

    private static string ActionClass(EntryChangeActionType action) => action switch
    {
        EntryChangeActionType.Created       => "ucm-badge-created",
        EntryChangeActionType.Updated       => "ucm-badge-updated",
        EntryChangeActionType.Deleted       => "ucm-badge-deleted",
        EntryChangeActionType.Approved      => "ucm-badge-approved",
        EntryChangeActionType.Rejected      => "ucm-badge-rejected",
        EntryChangeActionType.StatusChanged => "ucm-badge-status",
        _                                   => "ucm-badge-updated",
    };
}
