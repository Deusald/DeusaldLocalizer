@page "/"
@layout MainLayout
@inject ProjectStateService _ProjectState
@inject UpdateService       _Update
@inject NavigationManager   _Nav
@inject RecentProjectsStore _Recents
@inject IAuthTokenStore     _AuthTokens
@implements IDisposable

<div class="home-root">

    @* ── Left panel ───────────────────────────────────────────────────── *@
    <div class="home-left">
        <div>
            @if (_UpdateInfo is not null)
            {
                <div class="home-update">
                    <i class="bi bi-arrow-up-circle home-update-icon"></i>
                    <div class="home-update-text">
                        <span class="home-update-title">Update available</span>
                        <span class="home-update-sub">Version @_UpdateInfo.LatestVersion is available.</span>
                    </div>
                    @if (_UpdateInfo.DownloadPageUrl is not null)
                    {
                        @* macOS: no in-place update — open the releases page to download manually. *@
                        <button class="home-update-download" @onclick="OpenReleasePage">Download</button>
                        <button class="home-update-dismiss" @onclick="() => _UpdateInfo = null" title="Dismiss">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                    else if (_IsUpdating)
                    {
                        <button class="home-update-download" disabled>
                            <span class="dl-spinner" style="width:14px;height:14px;flex-shrink:0;"></span>
                            <span>Installing… @_UpdateProgress%</span>
                        </button>
                    }
                    else
                    {
                        <button class="home-update-download" @onclick="DownloadUpdate">Update</button>
                        <button class="home-update-dismiss" @onclick="() => _UpdateInfo = null" title="Dismiss">
                            <i class="bi bi-x"></i>
                        </button>
                    }
                </div>
            }

            <div class="home-logo">
                <div class="home-logo-orbs">
                    <div class="home-orb home-orb-1"></div>
                    <div class="home-orb home-orb-2"></div>
                    <div class="home-orb home-orb-3"></div>
                </div>
                <div>
                    <div class="home-logo-text-name">Deusald Localizer</div>
                    <div class="home-logo-text-sub">COMMUNITY LOCALIZATION</div>
                </div>
            </div>

            <h1 class="home-headline">Translate your game,<br/>together.</h1>
            <p class="home-sub">Edit strings, propose alternatives, and let the community vote on the best translation for every key.</p>
        </div>

        <div>
            @if (_ErrorMessage is not null)
            {
                <div class="dl-alert dl-alert-error home-error">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>@_ErrorMessage</span>
                </div>
            }

            <div class="home-actions">
                <button class="home-btn home-btn-primary"
                        @onclick="OpenNewProjectModal" disabled="@_IsLoading">
                    <span class="home-btn-icon">+</span>
                    <span>New project</span>
                </button>

                <button class="home-btn home-btn-secondary"
                        @onclick="PickFolder" disabled="@_IsLoading">
                    @if (_IsLoading)
                    {
                        <span class="dl-spinner" style="width:14px;height:14px;flex-shrink:0;"></span>
                        <span>Opening…</span>
                    }
                    else
                    {
                        <span class="home-btn-icon"><i class="bi bi-folder2-open"></i></span>
                        <span>Open project…</span>
                    }
                </button>

                <button class="home-btn home-btn-secondary"
                        @onclick="OpenConnectModal" disabled="@_IsLoading">
                    <span class="home-btn-dot"></span>
                    <span>Connect to server…</span>
                </button>
            </div>

            <div class="home-version">
                <span>v@(BuildInfo.Version)</span>
                @if (!string.IsNullOrEmpty(BuildInfo.CommitHash))
                {
                    <span class="home-version-sep">·</span>
                    <span class="home-version-hash">@BuildInfo.CommitHash</span>
                }
            </div>
        </div>
    </div>

    @* ── Right panel ──────────────────────────────────────────────────── *@
    <div class="home-right">
        <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:20px;">
            <div class="home-recents-label" style="margin-bottom:0;">Recent projects</div>
            @if (_RecentProjects.Count > 0)
            {
                <button class="home-clear-btn" @onclick="ClearRecentProjects">Clear</button>
            }
        </div>

        @if (_RecentProjects.Count == 0)
        {
            <div class="home-empty">
                <div class="home-empty-title">No recent projects</div>
                <div class="home-empty-sub">Projects you open will appear here<br/>so you can get back to them quickly.</div>
            </div>
        }
        else
        {
            <div class="home-recent-list">
                @{ string[] swatches = ["#5b6cff", "#3ad98a", "#ff6b6b", "#f5a623", "#a78bfa"]; }
                @for (int x = 0; x < _RecentProjects.Count; ++x)
                {
                    RecentProjectEntry recent  = _RecentProjects[x];
                    string             initial = recent.ProjectName.Length > 0 ? recent.ProjectName[0].ToString().ToUpper() : "P";
                    string             swatch  = swatches[x % swatches.Length];
                    int                pct     = recent.TranslationPct;
                    string meta = recent.KeyCount > 0
                                      ? $"{recent.KeyCount} keys · {recent.LangCount} langs · {recent.LastEditedLabel}"
                                      : recent.LastEditedLabel;

                    <div class="home-recent-item-wrap">
                        <button class="home-recent-item"
                                @onclick="() => LoadFromPath(recent.Path)"
                                disabled="@_IsLoading"
                                title="@recent.Path">
                            <div class="home-recent-swatch" style="background: @swatch">@initial</div>
                            <div class="home-recent-meta">
                                <div class="home-recent-top">
                                    <span class="home-recent-name">@recent.ProjectName</span>
                                    @if (recent.IsRemote)
                                    {
                                        <span class="home-recent-tag-remote">REMOTE</span>
                                    }
                                </div>
                                <div class="home-recent-sub">@meta</div>
                            </div>
                            @if (recent.KeyCount > 0)
                            {
                                <div class="home-recent-progress">
                                    <div class="home-recent-progress-top">
                                        <span>@recent.LangCount langs</span>
                                        <span class="home-recent-progress-pct">@pct%</span>
                                    </div>
                                    <div class="home-recent-progress-bar">
                                        <div class="home-recent-progress-fill" style="width: @pct%"></div>
                                    </div>
                                </div>
                            }
                            <i class="bi bi-chevron-right home-recent-arrow"></i>
                        </button>
                        <button class="home-recent-remove"
                                @onclick="() => RemoveRecent(recent)"
                                disabled="@_IsLoading"
                                title="Remove from recent">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    <NewProjectModal OnConfirm="OnNewProjectConfirmed" @ref="_NewProjectModal"/>

    <ConnectServerModal @ref="_ConnectModal"
                        OnConfirm="OnConnectConfirmed"
                        OnCancel="OnConnectCancelled"/>

    @if (_ShowLoginModal)
    {
        <LoginModal @ref="_LoginModal"
                    OnConfirm="OnLoginConfirmed"
                    OnCancel="OnLoginCancelled" />
    }

    <AccessTokenModal @ref="_AccessTokenModal" OnClose="OnAccessTokenAcknowledged" />

</div>

@code {
    // ── State ─────────────────────────────────────────────────────────────

    private bool                     _IsLoading;
    private string?                  _ErrorMessage;
    private List<RecentProjectEntry> _RecentProjects = [];

    // Tracks the path being opened when the login / token modal is showing
    private string?    _PendingPath;
    private LocProject? _PendingProject;
    private Guid        _PendingUserId;
    private bool        _ShowLoginModal;

    private NewProjectModal?    _NewProjectModal;
    private ConnectServerModal? _ConnectModal;
    private LoginModal?         _LoginModal;
    private AccessTokenModal?   _AccessTokenModal;

    private UpdateInfo? _UpdateInfo;
    private bool        _IsUpdating;
    private int         _UpdateProgress;

    // ── Lifecycle ─────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _ProjectState.ProjectChanged += OnProjectChanged;
        _RecentProjects              =  _Recents.LoadRecentProjects();
        _ = CheckForUpdateAsync();
    }

    private async Task CheckForUpdateAsync()
    {
        UpdateInfo? info = await _Update.CheckForUpdateAsync();
        if (info is null) return;
        _UpdateInfo = info;
        await InvokeAsync(StateHasChanged);
    }

    // macOS path: the app can't update itself, so open the GitHub releases page for a manual download.
    private async Task OpenReleasePage()
    {
        if (_UpdateInfo?.DownloadPageUrl is { } url)
            await Launcher.Default.OpenAsync(url);
    }

    private async Task DownloadUpdate()
    {
        if (_UpdateInfo is null || _IsUpdating) return;

        _IsUpdating = true;
        StateHasChanged();

        // The progress callback fires off the UI thread — marshal each tick back onto it.
        bool ok = await _Update.DownloadAndApplyAsync(pct =>
            _ = InvokeAsync(() => { _UpdateProgress = pct; StateHasChanged(); }));

        // On success the app relaunches into the new version and never returns here.
        if (!ok)
        {
            _IsUpdating   = false;
            _ErrorMessage = "The update could not be installed. Please try again later.";
            StateHasChanged();
        }
    }

    public void Dispose() => _ProjectState.ProjectChanged -= OnProjectChanged;

    private void OnProjectChanged() => InvokeAsync(StateHasChanged);

    // ── File operations ───────────────────────────────────────────────────

    private async Task PickFolder()
    {
        _ErrorMessage = null;
        try
        {
            FolderPickerResult result = await FolderPicker.Default.PickAsync();
            if (result.IsSuccessful) await LoadFromPath(result.Folder.Path);
        }
        catch (Exception ex)
        {
            _ErrorMessage = $"Could not open folder picker: {ex.Message}";
        }
    }

    private async Task LoadFromPath(string path)
    {
        _IsLoading    = true;
        _ErrorMessage = null;
        StateHasChanged();

        try
        {
            LocProject project = await ProjectFileService.OpenAsync(path);

            // Replay any pending (unpushed) changes onto the in-memory project so the UI reflects
            // local edits that have not yet been committed to the server.
            foreach (LocEntryChange change in project.UncommitedChanges)
                EntryChangeExeService.ExecuteChange(project, change, out _);

            bool isOnline = project.Metadata.IsOnline;

            if (isOnline)
            {
                await LoadOnlineProject(project, path);
            }
            else
            {
                // Offline — always use the offline member, no session token needed
                FinalizeLoad(project, path, LocProjectMember.OfflineMember.UserId, Guid.Empty);
            }
        }
        catch (ProjectFolderException ex)
        {
            _ErrorMessage = $"Invalid project: {ex.Message}";
            _IsLoading    = false;
        }
        catch (Exception ex)
        {
            _ErrorMessage = $"Failed to load project: {ex.Message}";
            _IsLoading    = false;
        }
    }

    // ── Online auth flow ──────────────────────────────────────────────────

    private async Task LoadOnlineProject(LocProject project, string path)
    {
        (Guid UserId, string Token)? cached = await _AuthTokens.GetAsync(project.Metadata.Id, path);

        if (cached != null)
        {
            // Re-verify the cached raw token against the stored BCrypt hash
            if (VerifyCredentials(project, cached.Value.UserId, cached.Value.Token))
            {
                // Generate a new session token Guid for this session
                FinalizeLoad(project, path, cached.Value.UserId, Guid.NewGuid());
                return;
            }

            // Token no longer valid — remove and fall through to login
            _AuthTokens.Remove(project.Metadata.Id, path);
        }

        // No valid cached credentials — show the login modal
        _PendingPath    = path;
        _PendingProject = project;
        _ShowLoginModal = true;
        _IsLoading      = false;
        StateHasChanged();

        await Task.Yield();
        _LoginModal?.Show(project.Metadata.Name);
    }

    private async Task OnLoginConfirmed((string username, string accessToken) credentials)
    {
        if (_PendingProject == null || _PendingPath == null) return;

        _IsLoading = true;
        StateHasChanged();

        if (!VerifyCredentials(_PendingProject, credentials.username, credentials.accessToken,
                out LocProjectMember? member))
        {
            _IsLoading = false;
            _LoginModal?.ShowError("Username or access token is incorrect.");
            return;
        }

        Guid projectId = _PendingProject.Metadata.Id;

        // First sign-in: the member is still carrying the one-time token an admin issued. Rotate it
        // to a fresh random token and push that straight away — authenticated with the token the user
        // just entered, because the server still only knows the one-time token and so the new one
        // cannot push itself. Only once the server accepts it do we adopt it locally and show it once
        // for the user to store.
        if (member!.MustResetAccessToken)
        {
            InitialTokenResult result = await _ProjectState.RotateInitialTokenAsync(
                _PendingProject, _PendingPath, member!, credentials.accessToken);

            if (result.RawToken == null)
            {
                _IsLoading = false;
                _LoginModal?.ShowError(result.Error ?? "Could not complete first sign-in. Please try again.");
                return;
            }

            _PendingProject = result.Project!;
            _ShowLoginModal = false;
            _PendingUserId  = member!.UserId;
            StateHasChanged();

            _AccessTokenModal?.Show(result.RawToken, "Your access token",
                "This is your new sign-in token. Copy it now and keep it safe — you'll use it to sign in from now on.");
            return; // FinalizeLoad runs once the user closes the token modal
        }

        // Returning user — cache the raw token for next time and load straight in.
        await _AuthTokens.SaveAsync(projectId, _PendingPath, member!.UserId, credentials.accessToken);

        _ShowLoginModal = false;
        FinalizeLoad(_PendingProject, _PendingPath, member.UserId, Guid.NewGuid());
    }

    private void OnAccessTokenAcknowledged()
    {
        if (_PendingProject == null || _PendingPath == null) return;
        FinalizeLoad(_PendingProject, _PendingPath, _PendingUserId, Guid.NewGuid());
    }

    private void OnLoginCancelled()
    {
        _PendingPath    = null;
        _PendingProject = null;
        _ShowLoginModal = false;
        _IsLoading      = false;
        StateHasChanged();
    }

    /// <summary>
    /// Checks that the given username exists in the project's member list
    /// and that the BCrypt hash of their access token matches the stored hash.
    /// </summary>
    private static bool VerifyCredentials(
        LocProject          project,
        Guid                userId,
        string              accessToken)
    {
        LocProjectMember? member = project.ProjectMembers.Find(m => m.UserId == userId);
        if (member == null) return false;
        return AccessTokenService.VerifyToken(accessToken, member.HashedAccessToken);
    }

    /// <summary>Overload that looks up by username string instead of Guid.</summary>
    private static bool VerifyCredentials(
        LocProject          project,
        string              username,
        string              accessToken,
        out LocProjectMember? member)
    {
        member = project.ProjectMembers.Find(m =>
            string.Equals(m.Username, username, StringComparison.OrdinalIgnoreCase));
        if (member == null) return false;
        return AccessTokenService.VerifyToken(accessToken, member.HashedAccessToken);
    }

    private void FinalizeLoad(LocProject project, string path, Guid userId, Guid sessionToken)
    {
        _ProjectState.LoadProject(project, path, userId, sessionToken);
        _RecentProjects = _Recents.UpdateRecentProjects(project, path, project.Metadata.IsOnline);
        _IsLoading      = false;
        _Nav.NavigateTo("/translate");
    }

    // ── New project ───────────────────────────────────────────────────────

    private void OpenNewProjectModal() => _NewProjectModal?.Show();

    private void OnNewProjectConfirmed(NewProjectModal.NewProjectArgs args)
    {
        _ProjectState.CreateNewProject(args.Name, args.Slug, args.Description, args.MainLanguageCode);
        _Nav.NavigateTo("/translate");
    }

    // ── Connect to server ─────────────────────────────────────────────────

    private void OpenConnectModal() => _ConnectModal?.Show();

    private void OnConnectCancelled() { /* modal hides itself */ }

    /// <summary>
    /// Downloads a whole online project from the bot into a new folder named after the project slug,
    /// then finalizes exactly like opening a local online project. A member still carrying the admin's
    /// one-time token (first sign-in) rotates it to their own; a returning member — redownloading or
    /// setting up on another PC — keeps their existing token and loads straight in, no reset.
    /// </summary>
    private async Task OnConnectConfirmed(ConnectServerModal.ConnectArgs args)
    {
        ConnectResult result = await _ProjectState.ConnectToServerAsync(
            args.ApiUrl, args.ProjectId, args.Username, args.Token,
            meta => Path.Combine(args.ParentLocation, SanitizeFolder(meta.Slug)));

        if (result.Error != null || result.Project is null || result.Location is null || result.Member is null)
        {
            _ConnectModal?.ShowError(result.Error ?? "Could not connect to the project. Please try again.");
            return;
        }

        LocProjectMember member = result.Member;

        // First connect: the member still carries the admin-issued one-time token. Rotate it to a fresh
        // random token straight away (authenticated with the token the user just entered — the only one
        // the server knows), then show it once for them to store. Mirrors OnLoginConfirmed.
        if (member.MustResetAccessToken)
        {
            InitialTokenResult rotation = await _ProjectState.RotateInitialTokenAsync(
                result.Project, result.Location, member, args.Token);

            if (rotation.RawToken == null)
            {
                _ConnectModal?.ShowError(rotation.Error ?? "Could not complete sign-in. Please try again.");
                return;
            }

            _PendingProject = rotation.Project!;
            _PendingPath    = result.Location;
            _PendingUserId  = member.UserId;
            _ConnectModal?.Hide();
            StateHasChanged();

            _AccessTokenModal?.Show(rotation.RawToken, "Your access token",
                "This is your new sign-in token. Copy it now and keep it safe — you'll use it to sign in from now on.");
            return; // FinalizeLoad runs once the user closes the token modal
        }

        // Returning member — cache the raw token for next time and load straight in.
        await _AuthTokens.SaveAsync(result.Project.Metadata.Id, result.Location, member.UserId, args.Token);
        _ConnectModal?.Hide();
        FinalizeLoad(result.Project, result.Location, member.UserId, Guid.NewGuid());
    }

    /// <summary>Strips characters that are illegal in a folder name; the slug is normally already safe.</summary>
    private static string SanitizeFolder(string slug)
    {
        foreach (char c in Path.GetInvalidFileNameChars())
            slug = slug.Replace(c.ToString(), string.Empty);
        slug = slug.Trim();
        return slug.Length == 0 ? "project" : slug;
    }

    // ── Recents ───────────────────────────────────────────────────────────

    private void ClearRecentProjects()
    {
        _RecentProjects.Clear();
        _Recents.ClearRecentProjects();
    }

    private void RemoveRecent(RecentProjectEntry recent)
    {
        _RecentProjects = _Recents.RemoveRecentProject(recent);
    }
}
