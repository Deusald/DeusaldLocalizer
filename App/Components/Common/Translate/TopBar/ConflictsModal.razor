@namespace App.Components.Common
@inject ProjectStateService _ProjectState

@if (_Visible)
{
    <div class="cfm-backdrop" @onclick="Close"></div>

    <div class="cfm-box" @onclick:stopPropagation="true">

        <div class="cfm-header">
            <div class="cfm-header-left">
                <i class="bi bi-exclamation-triangle-fill cfm-header-icon"></i>
                <span class="cfm-title">@_Title</span>
            </div>
            <button class="cfm-close" @onclick="Close"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="cfm-body">

            @if (!string.IsNullOrEmpty(_ErrorMessage))
            {
                <div class="cfm-error">
                    <i class="bi bi-x-octagon-fill"></i>
                    <span>@_ErrorMessage</span>
                </div>
            }

            @if (_ProjectState.HasSyncConflicts)
            {
                <p class="cfm-intro">
                    These changes clash with newer edits already on the server. Open each one to choose
                    how to resolve it, then push again.
                </p>

                @foreach (EntryChangeConflict conflict in _ProjectState.SyncConflicts)
                {
                    EntryChangeConflict c = conflict;
                    <button class="cfm-item" @onclick="() => OpenConflict(c)">
                        <span class="cfm-item-kind @KindClass(c.Type)">@KindLabel(c.Type)</span>
                        <span class="cfm-item-main">
                            <span class="cfm-item-key">@c.KeyName</span>
                            <span class="cfm-item-msg">@c.Message</span>
                        </span>
                        <span class="cfm-item-lang">@c.LanguageId</span>
                        <i class="bi bi-chevron-right cfm-item-chevron"></i>
                    </button>
                }
            }
            else if (string.IsNullOrEmpty(_ErrorMessage))
            {
                <div class="cfm-empty">
                    <i class="bi bi-check-circle cfm-empty-icon"></i>
                    <span>No conflicts — you're good to push.</span>
                </div>
            }

        </div>

    </div>
}

@code {
    private bool    _Visible;
    private string? _ErrorMessage;

    private string _Title => _ProjectState.HasSyncConflicts
        ? $"{_ProjectState.SyncConflicts.Count} {(_ProjectState.SyncConflicts.Count == 1 ? "conflict" : "conflicts")} to resolve"
        : "Can't push";

    /// <summary>Opens the modal to browse the current sync conflicts.</summary>
    public void Show()
    {
        _ErrorMessage = null;
        _Visible      = true;
        StateHasChanged();
    }

    /// <summary>Opens the modal to explain why a push was blocked or failed (alongside any conflicts).</summary>
    public void ShowError(string? message)
    {
        _ErrorMessage = message;
        _Visible      = true;
        StateHasChanged();
    }

    private void Close() => _Visible = false;

    private void OpenConflict(EntryChangeConflict conflict)
    {
        _Visible = false;
        _ProjectState.RequestOpenKey(conflict.KeyId, conflict.LanguageId);
    }

    private static string KindLabel(EntryConflictType type) => type switch
    {
        EntryConflictType.SourceChanged => "source",
        EntryConflictType.DestChanged   => "edited",
        _                               => "conflict",
    };

    private static string KindClass(EntryConflictType type) => type switch
    {
        EntryConflictType.SourceChanged => "cfm-kind-source",
        _                               => "cfm-kind-dest",
    };
}
