@namespace App.Components.Common
@inject ProjectStateService _ProjectState

@if (_Visible)
{
    <div class="im-backdrop" @onclick="Close"></div>

    <div class="im-box" @onclick:stopPropagation="true">

        <div class="im-header">
            <span class="im-title">Import from Excel</span>
            <button class="im-close" @onclick="Close"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="im-body">

            @if (_Result == null && !_IsImporting)
            {
                <div class="im-desc">
                    Select an <code>.xlsx</code> exported from this project. Rows are matched by
                    <strong>KeyId</strong>; cells that still match their <code>#hash</code> are skipped.
                </div>

                @if (_Error != null)
                {
                    <div class="im-alert im-alert-error">
                        <i class="bi bi-exclamation-triangle"></i> @_Error
                    </div>
                }

                @* ── What to update ─────────────────────────────────────── *@
                <div class="im-section">
                    <div class="im-section-header">
                        <span class="im-section-title">Update from sheet</span>
                        <button class="im-linkbtn" @onclick="ToggleAll">
                            @(_AllSelected ? "Deselect all" : "Select all")
                        </button>
                    </div>
                    <label class="im-check"><input type="checkbox" @bind="_Options.CreateNewKeys" /><span>Create keys missing from the project</span></label>
                    <label class="im-check"><input type="checkbox" @bind="_Options.UpdateCategories" /><span>Update categories <span class="im-check-hint">— creates missing</span></span></label>
                    <label class="im-check"><input type="checkbox" @bind="_Options.UpdateDescriptions" /><span>Update descriptions</span></label>
                    <label class="im-check"><input type="checkbox" @bind="_Options.UpdateTags" /><span>Update tags</span></label>
                    <label class="im-check"><input type="checkbox" @bind="_Options.UpdateMaxLength" /><span>Update max length</span></label>
                    <label class="im-check"><input type="checkbox" @bind="_Options.UpdateSourceText" /><span>Update source text</span></label>
                </div>

                @* ── How to import translations ─────────────────────────── *@
                <div class="im-section">
                    <span class="im-section-title">Translations import as</span>
                    <div class="im-seg">
                        <button class="im-seg-btn @(_Options.ImportAsSuggestions ? "active" : "")"
                                @onclick="() => _Options.ImportAsSuggestions = true">Suggestions</button>
                        <button class="im-seg-btn @(!_Options.ImportAsSuggestions ? "active" : "")"
                                @onclick="() => _Options.ImportAsSuggestions = false">Direct text</button>
                    </div>
                    <div class="im-section-hint">
                        @(_Options.ImportAsSuggestions
                            ? "Changed cells become suggestions to review and approve."
                            : "Changed cells overwrite the approved translation directly.")
                    </div>
                </div>

                <button class="im-pick-btn" @onclick="PickAndImport">
                    <i class="bi bi-file-earmark-spreadsheet"></i>
                    Choose file…
                </button>
            }
            else if (_IsImporting)
            {
                <div class="im-progress">
                    <span class="im-spinner"></span>
                    <span>Importing…</span>
                </div>
            }
            else if (_Result != null)
            {
                <div class="im-result">
                    @if (_Result.KeysCreated > 0)
                    {
                        <div class="im-stat"><span class="im-stat-value">@_Result.KeysCreated</span><span class="im-stat-label">keys created</span></div>
                    }
                    <div class="im-stat"><span class="im-stat-value">@_Result.KeysUpdated</span><span class="im-stat-label">keys updated</span></div>
                    @if (_Result.TranslationsUpdated > 0)
                    {
                        <div class="im-stat"><span class="im-stat-value">@_Result.TranslationsUpdated</span><span class="im-stat-label">translations set</span></div>
                    }
                    @if (_Result.SuggestionsAdded > 0)
                    {
                        <div class="im-stat"><span class="im-stat-value">@_Result.SuggestionsAdded</span><span class="im-stat-label">suggestions added</span></div>
                    }
                    @if (_Result.CategoriesCreated > 0)
                    {
                        <div class="im-stat"><span class="im-stat-value">@_Result.CategoriesCreated</span><span class="im-stat-label">categories created</span></div>
                    }
                    @if (_Result.KeysSkipped > 0)
                    {
                        <div class="im-stat im-stat-warn"><span class="im-stat-value">@_Result.KeysSkipped</span><span class="im-stat-label">rows skipped</span></div>
                    }
                </div>

                @if (_Result.Warnings.Count > 0)
                {
                    <div class="im-warnings">
                        @foreach (string w in _Result.Warnings)
                        {
                            <div class="im-warning-row"><i class="bi bi-exclamation-triangle"></i> @w</div>
                        }
                    </div>
                }
            }

        </div>

        @if (_Result != null)
        {
            <div class="im-footer">
                <button class="im-btn im-btn-ghost" @onclick="Reset">Import another</button>
                <button class="im-btn im-btn-primary" @onclick="Close">Done</button>
            </div>
        }

    </div>
}

@code {
    private bool             _Visible;
    private bool             _IsImporting;
    private ImportResult?    _Result;
    private string?          _Error;
    private LocImportOptions _Options = new();

    private bool _AllSelected =>
        _Options.CreateNewKeys && _Options.UpdateCategories && _Options.UpdateDescriptions &&
        _Options.UpdateTags && _Options.UpdateMaxLength && _Options.UpdateSourceText;

    public void Show()
    {
        _Result      = null;
        _Error       = null;
        _IsImporting = false;
        _Options     = new LocImportOptions();
        _Visible     = true;
        StateHasChanged();
    }

    private void Close() => _Visible = false;

    private void Reset()
    {
        _Result      = null;
        _Error       = null;
        _IsImporting = false;
    }

    private void ToggleAll()
    {
        bool value = !_AllSelected;
        _Options.CreateNewKeys      = value;
        _Options.UpdateCategories   = value;
        _Options.UpdateDescriptions = value;
        _Options.UpdateTags         = value;
        _Options.UpdateMaxLength    = value;
        _Options.UpdateSourceText   = value;
    }

    private async Task PickAndImport()
    {
        _Error = null;

        try
        {
            PickOptions options = new PickOptions
            {
                PickerTitle = "Select exported .xlsx file",
                FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    { DevicePlatform.WinUI, [".xlsx"] },
                    { DevicePlatform.macOS, ["xlsx"] },
                }),
            };

            FileResult? picked = await FilePicker.Default.PickAsync(options);
            if (picked == null) return;

            _IsImporting = true;
            StateHasChanged();

            await Task.Yield(); // let the spinner render

            await using Stream stream = await picked.OpenReadAsync();
            _Result = LocalizationImportService.ImportFromStream(
                stream,
                _ProjectState.CurrentProject!,
                _ProjectState.CurrentUser.UserId,
                _Options);

            // Replay each mutation into the change log (in order) so it populates
            // UncommitedChanges when online, marks keys dirty and flags the app dirty.
            foreach (ImportedChange change in _Result.Changes)
                RecordChange(change);
        }
        catch (Exception ex)
        {
            _Error = $"Import failed: {ex.Message}";
        }
        finally
        {
            _IsImporting = false;
            StateHasChanged();
        }
    }

    private void RecordChange(ImportedChange change)
    {
        switch (change.Kind)
        {
            case ImportChangeKind.CategoryAdded:         _ProjectState.RecordCategoryAdded(change.Category!);                                    break;
            case ImportChangeKind.KeyAdded:              _ProjectState.RecordKeyAdded(change.Key!);                                              break;
            case ImportChangeKind.KeyCategoryChanged:    _ProjectState.RecordKeyCategoryChanged(change.Key!);                                    break;
            case ImportChangeKind.KeyDescriptionChanged: _ProjectState.RecordKeyDescriptionChanged(change.Key!);                                 break;
            case ImportChangeKind.KeyMaxLengthChanged:   _ProjectState.RecordKeyMaxLengthChanged(change.Key!);                                   break;
            case ImportChangeKind.TagAdded:              _ProjectState.RecordTagAdded(change.KeyId, change.Tag);                                 break;
            case ImportChangeKind.TagRemoved:            _ProjectState.RecordTagRemoved(change.KeyId, change.Tag);                               break;
            case ImportChangeKind.TranslationUpdated:    _ProjectState.RecordTranslationUpdated(change.KeyId, change.Translation!, change.PrevDestHash); break;
            case ImportChangeKind.SuggestionAdded:       _ProjectState.RecordSuggestionAdded(change.KeyId, change.LanguageId, change.Suggestion!);       break;
        }
    }

}
