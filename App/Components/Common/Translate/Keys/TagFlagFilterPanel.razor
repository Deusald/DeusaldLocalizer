@namespace App.Components.Translate
@inject ProjectStateService _ProjectState

<div class="tff-root">

    @if (!_Expanded)
    {
        <button class="tff-trigger" @onclick="() => _Expanded = true">
            <i class="bi bi-tags tff-trigger-icon"></i>
            <span class="tff-trigger-label">@_TriggerLabel</span>
            <i class="bi bi-chevron-down tff-trigger-chevron"></i>
        </button>
    }
    else
    {
        <div class="tff-panel">
            <div class="tff-panel-header">
                <span class="tff-panel-title">Filter by flag &amp; tag</span>
                <div class="tff-panel-actions">
                    @if (SelectedFlagTypes.Count > 0 || SelectedTags.Count > 0)
                    {
                        <button class="tff-clear-btn" @onclick="ClearAll">Clear</button>
                    }
                    <button class="tff-collapse-btn" @onclick="() => _Expanded = false">
                        <i class="bi bi-chevron-up"></i>
                    </button>
                </div>
            </div>

            <div class="tff-body">
                <div class="tff-section-title">Flags</div>
                <div class="tff-list">
                    @foreach (FlagType type in _AllFlagTypes)
                    {
                        FlagType t      = type;
                        bool     active = SelectedFlagTypes.Contains(t);
                        <button class="tff-item @(active ? "active" : "")" @onclick="() => ToggleFlag(t)">
                            <span class="tff-item-check">@(active ? "✓" : "")</span>
                            <i class="bi @FlagIcon(t) tff-item-icon"></i>
                            <span class="tff-item-name">@FlagLabel(t)</span>
                        </button>
                    }
                </div>

                <div class="tff-section-title">Tags</div>
                <div class="tff-list">
                    @if (_AllTags.Count == 0)
                    {
                        <div class="tff-empty">No tags yet.</div>
                    }
                    else
                    {
                        @foreach (string tag in _AllTags)
                        {
                            string t      = tag;
                            bool   active = SelectedTags.Contains(t);
                            <button class="tff-item @(active ? "active" : "")" @onclick="() => ToggleTag(t)">
                                <span class="tff-item-check">@(active ? "✓" : "")</span>
                                <i class="bi bi-tag tff-item-icon"></i>
                                <span class="tff-item-name">@t</span>
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public HashSet<FlagType> SelectedFlagTypes { get; set; } = new();
    [Parameter] public HashSet<string>   SelectedTags      { get; set; } = new();
    [Parameter] public EventCallback<HashSet<FlagType>> OnFlagsChanged { get; set; }
    [Parameter] public EventCallback<HashSet<string>>   OnTagsChanged  { get; set; }

    private bool _Expanded;

    private static readonly FlagType[] _AllFlagTypes = (FlagType[])Enum.GetValues(typeof(FlagType));

    private List<string> _AllTags =>
        _ProjectState.CurrentProject!.Keys
                     .SelectMany(k => k.Tags)
                     .Distinct(StringComparer.OrdinalIgnoreCase)
                     .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
                     .ToList();

    private string _TriggerLabel
    {
        get
        {
            int count = SelectedFlagTypes.Count + SelectedTags.Count;
            if (count == 0) return "All flags & tags";
            if (count == 1)
            {
                if (SelectedFlagTypes.Count == 1) return FlagLabel(SelectedFlagTypes.First());
                return SelectedTags.First();
            }
            return $"{count} filters";
        }
    }

    private async Task ToggleFlag(FlagType type)
    {
        HashSet<FlagType> next = new HashSet<FlagType>(SelectedFlagTypes);
        if (!next.Remove(type)) next.Add(type);
        await OnFlagsChanged.InvokeAsync(next);
    }

    private async Task ToggleTag(string tag)
    {
        HashSet<string> next = new HashSet<string>(SelectedTags, StringComparer.OrdinalIgnoreCase);
        if (!next.Remove(tag)) next.Add(tag);
        await OnTagsChanged.InvokeAsync(next);
    }

    private async Task ClearAll()
    {
        await OnFlagsChanged.InvokeAsync(new HashSet<FlagType>());
        await OnTagsChanged.InvokeAsync(new HashSet<string>(StringComparer.OrdinalIgnoreCase));
    }

    private static string FlagLabel(FlagType type) => type switch
    {
        FlagType.NeedsReview    => "Needs review",
        FlagType.Outdated       => "Outdated",
        FlagType.DoNotTranslate => "Do not translate",
        FlagType.InProgress     => "In progress",
        FlagType.Disputed       => "Disputed",
        _                       => type.ToString(),
    };

    private static string FlagIcon(FlagType type) => type switch
    {
        FlagType.NeedsReview    => "bi-flag",
        FlagType.Outdated       => "bi-clock-history",
        FlagType.DoNotTranslate => "bi-slash-circle",
        FlagType.InProgress     => "bi-hourglass-split",
        FlagType.Disputed       => "bi-exclamation-triangle",
        _                       => "bi-flag",
    };
}
