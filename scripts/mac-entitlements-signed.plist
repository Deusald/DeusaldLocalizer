<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for a SIGNED (self-signed) direct-download build. Identical to mac-entitlements.plist
  (hardened-runtime allowances, NO App Sandbox) plus a keychain access group.

  The keychain group is what makes MAUI SecureStorage work: under Mac Catalyst SecureStorage uses the
  iOS-style data-protection keychain, which refuses access (errSecMissingEntitlement, -34018) unless the
  signed app declares a keychain-access-group. A self-signed certificate has no Apple team identifier, so
  there is no "$(AppIdentifierPrefix)" to prepend — the group is just the literal bundle id.

  Only used when build-release-mac.sh signs with a real identity; ad-hoc builds keep mac-entitlements.plist
  (an ad-hoc signature can't satisfy a keychain group anyway, so adding it there would only mislead).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>com.deusald.localizer</string>
	</array>
</dict>
</plist>
